</span><span class="Comment-dh5VVn">/* =========================================================</span><span>
</span><span class="Comment-dh5VVn">   11. LUNAR ROVING VEHICLE</span><span>
</span><span class="Comment-dh5VVn">========================================================= */</span><span>

</span><span class="text-codex-syntax-keyword">function </span><span class="text-codex-syntax-variable">createLunarRover</span><span>() {

    </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">group </span><span class="text-codex-syntax-keyword">= new </span><span class="text-codex-syntax-literal">THREE</span><span>.</span><span class="text-codex-syntax-variable">Group</span><span>();

    </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">frame </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">material</span><span>(</span><span class="text-codex-syntax-literal">0xb9b9ad</span><span>, </span><span class="text-codex-syntax-literal">0.55</span><span>, </span><span class="text-codex-syntax-literal">0.65</span><span>);
    </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">dark </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">material</span><span>(</span><span class="text-codex-syntax-literal">0x24282d</span><span>, </span><span class="text-codex-syntax-literal">0.8</span><span>, </span><span class="text-codex-syntax-literal">0.2</span><span>);
    </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">gold </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">material</span><span>(</span><span class="text-codex-syntax-literal">0xb99b5c</span><span>, </span><span class="text-codex-syntax-literal">0.5</span><span>, </span><span class="text-codex-syntax-literal">0.6</span><span>);

    </span><span class="text-codex-syntax-variable">addBox</span><span>(</span><span class="text-codex-syntax-variable">group</span><span>, </span><span class="text-codex-syntax-literal">0</span><span>, </span><span class="text-codex-syntax-literal">1.7</span><span>, </span><span class="text-codex-syntax-literal">0</span><span>, </span><span class="text-codex-syntax-literal">4.5</span><span>, </span><span class="text-codex-syntax-literal">0.25</span><span>, </span><span class="text-codex-syntax-literal">2.4</span><span>, </span><span class="text-codex-syntax-variable">frame</span><span>);

    </span><span class="text-codex-syntax-variable">addBox</span><span>(</span><span class="text-codex-syntax-variable">group</span><span>, </span><span class="text-codex-syntax-literal">0</span><span>, </span><span class="text-codex-syntax-literal">2.1</span><span>, </span><span class="text-codex-syntax-keyword">-</span><span class="text-codex-syntax-literal">0.2</span><span>, </span><span class="text-codex-syntax-literal">1.5</span><span>, </span><span class="text-codex-syntax-literal">0.5</span><span>, </span><span class="text-codex-syntax-literal">1.2</span><span>, </span><span class="text-codex-syntax-variable">gold</span><span>);

    </span><span class="text-codex-syntax-variable">addBox</span><span>(</span><span class="text-codex-syntax-variable">group</span><span>, </span><span class="text-codex-syntax-literal">0</span><span>, </span><span class="text-codex-syntax-literal">2.8</span><span>, </span><span class="text-codex-syntax-keyword">-</span><span class="text-codex-syntax-literal">0.8</span><span>, </span><span class="text-codex-syntax-literal">0.8</span><span>, </span><span class="text-codex-syntax-literal">1.2</span><span>, </span><span class="text-codex-syntax-literal">0.1</span><span>, </span><span class="text-codex-syntax-variable">dark</span><span>);

    </span><span class="text-codex-syntax-keyword">for </span><span>(</span><span class="text-codex-syntax-keyword">let </span><span class="text-codex-syntax-variable">side </span><span class="text-codex-syntax-keyword">of </span><span>[</span><span class="text-codex-syntax-keyword">-</span><span class="text-codex-syntax-literal">1</span><span>, </span><span class="text-codex-syntax-literal">1</span><span>]) {

        </span><span class="text-codex-syntax-keyword">for </span><span>(</span><span class="text-codex-syntax-keyword">let </span><span class="text-codex-syntax-variable">front </span><span class="text-codex-syntax-keyword">of </span><span>[</span><span class="text-codex-syntax-keyword">-</span><span class="text-codex-syntax-literal">1</span><span>, </span><span class="text-codex-syntax-literal">1</span><span>]) {

            </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">wheel </span><span class="text-codex-syntax-keyword">= new </span><span class="text-codex-syntax-literal">THREE</span><span>.</span><span class="text-codex-syntax-variable">Mesh</span><span>(
                </span><span class="text-codex-syntax-keyword">new </span><span class="text-codex-syntax-literal">THREE</span><span>.</span><span class="text-codex-syntax-variable">CylinderGeometry</span><span>(</span><span class="text-codex-syntax-literal">0.8</span><span>, </span><span class="text-codex-syntax-literal">0.8</span><span>, </span><span class="text-codex-syntax-literal">0.35</span><span>, </span><span class="text-codex-syntax-literal">16</span><span>),
                </span><span class="text-codex-syntax-variable">dark</span><span>
</span><span class="text-codex-syntax-variable">            </span><span>);

            </span><span class="text-codex-syntax-variable">wheel</span><span>.</span><span class="text-codex-syntax-attribute">rotation</span><span>.</span><span class="text-codex-syntax-attribute">z </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">Math</span><span>.</span><span class="text-codex-syntax-attribute">PI </span><span class="text-codex-syntax-keyword">/ </span><span class="text-codex-syntax-literal">2</span><span>;

            </span><span class="text-codex-syntax-variable">wheel</span><span>.</span><span class="text-codex-syntax-attribute">position</span><span>.</span><span class="text-codex-syntax-variable">set</span><span>(
                </span><span class="text-codex-syntax-variable">side </span><span class="text-codex-syntax-keyword">* </span><span class="text-codex-syntax-literal">2.2</span><span>,
                </span><span class="text-codex-syntax-literal">0.8</span><span>,
                </span><span class="text-codex-syntax-variable">front </span><span class="text-codex-syntax-keyword">* </span><span class="text-codex-syntax-literal">1.2</span><span>
</span><span class="text-codex-syntax-literal">            </span><span>);

            </span><span class="text-codex-syntax-variable">group</span><span>.</span><span class="text-codex-syntax-variable">add</span><span>(</span><span class="text-codex-syntax-variable">wheel</span><span>);

        }

    }

    </span><span class="text-codex-syntax-variable">group</span><span>.</span><span class="text-codex-syntax-attribute">position</span><span>.</span><span class="text-codex-syntax-variable">set</span><span>(</span><span class="text-codex-syntax-literal">0</span><span>, </span><span class="text-codex-syntax-literal">0</span><span>, </span><span class="text-codex-syntax-keyword">-</span><span class="text-codex-syntax-literal">8</span><span>);
    </span><span class="text-codex-syntax-variable">group</span><span>.</span><span class="text-codex-syntax-attribute">scale</span><span>.</span><span class="text-codex-syntax-variable">set</span><span>(</span><span class="text-codex-syntax-literal">1.4</span><span>, </span><span class="text-codex-syntax-literal">1.4</span><span>, </span><span class="text-codex-syntax-literal">1.4</span><span>);

    </span><span class="text-codex-syntax-variable">scene</span><span>.</span><span class="text-codex-syntax-variable">add</span><span>(</span><span class="text-codex-syntax-variable">group</span><span>);

}


</span><span class="Comment-dh5VVn">/* =========================================================</span><span>
</span><span class="Comment-dh5VVn">   12. SOJOURNER ROVER</span><span>
</span><span class="Comment-dh5VVn">========================================================= */</span><span>

</span><span class="text-codex-syntax-keyword">function </span><span class="text-codex-syntax-variable">createSojourner</span><span>() {

    </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">group </span><span class="text-codex-syntax-keyword">= new </span><span class="text-codex-syntax-literal">THREE</span><span>.</span><span class="text-codex-syntax-variable">Group</span><span>();

