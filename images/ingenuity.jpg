    }

    </span><span class="text-codex-syntax-keyword">if </span><span>(</span><span class="text-codex-syntax-variable">keys</span><span>[</span><span class="text-codex-syntax-string">"KeyS"</span><span>] </span><span class="text-codex-syntax-keyword">|| </span><span class="text-codex-syntax-variable">keys</span><span>[</span><span class="text-codex-syntax-string">"ArrowDown"</span><span>]) {
        </span><span class="text-codex-syntax-variable">playerPosition</span><span>.</span><span class="text-codex-syntax-variable">addScaledVector</span><span>(</span><span class="text-codex-syntax-variable">forward</span><span>, </span><span class="text-codex-syntax-keyword">-</span><span class="text-codex-syntax-variable">speed</span><span>);
    }

    </span><span class="text-codex-syntax-keyword">if </span><span>(</span><span class="text-codex-syntax-variable">keys</span><span>[</span><span class="text-codex-syntax-string">"KeyA"</span><span>] </span><span class="text-codex-syntax-keyword">|| </span><span class="text-codex-syntax-variable">keys</span><span>[</span><span class="text-codex-syntax-string">"ArrowLeft"</span><span>]) {
        </span><span class="text-codex-syntax-variable">playerPosition</span><span>.</span><span class="text-codex-syntax-variable">addScaledVector</span><span>(</span><span class="text-codex-syntax-variable">right</span><span>, </span><span class="text-codex-syntax-keyword">-</span><span class="text-codex-syntax-variable">speed</span><span>);
    }

    </span><span class="text-codex-syntax-keyword">if </span><span>(</span><span class="text-codex-syntax-variable">keys</span><span>[</span><span class="text-codex-syntax-string">"KeyD"</span><span>] </span><span class="text-codex-syntax-keyword">|| </span><span class="text-codex-syntax-variable">keys</span><span>[</span><span class="text-codex-syntax-string">"ArrowRight"</span><span>]) {
        </span><span class="text-codex-syntax-variable">playerPosition</span><span>.</span><span class="text-codex-syntax-variable">addScaledVector</span><span>(</span><span class="text-codex-syntax-variable">right</span><span>, </span><span class="text-codex-syntax-variable">speed</span><span>);
    }

    </span><span class="text-codex-syntax-variable">playerPosition</span><span>.</span><span class="text-codex-syntax-attribute">x </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-literal">THREE</span><span>.</span><span class="text-codex-syntax-attribute">MathUtils</span><span>.</span><span class="text-codex-syntax-variable">clamp</span><span>(
        </span><span class="text-codex-syntax-variable">playerPosition</span><span>.</span><span class="text-codex-syntax-attribute">x</span><span>, </span><span class="text-codex-syntax-keyword">-</span><span class="text-codex-syntax-literal">100</span><span>, </span><span class="text-codex-syntax-literal">100</span><span>
</span><span class="text-codex-syntax-literal">    </span><span>);

    </span><span class="text-codex-syntax-variable">playerPosition</span><span>.</span><span class="text-codex-syntax-attribute">z </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-literal">THREE</span><span>.</span><span class="text-codex-syntax-attribute">MathUtils</span><span>.</span><span class="text-codex-syntax-variable">clamp</span><span>(
        </span><span class="text-codex-syntax-variable">playerPosition</span><span>.</span><span class="text-codex-syntax-attribute">z</span><span>, </span><span class="text-codex-syntax-keyword">-</span><span class="text-codex-syntax-literal">100</span><span>, </span><span class="text-codex-syntax-literal">100</span><span>
</span><span class="text-codex-syntax-literal">    </span><span>);

    </span><span class="text-codex-syntax-variable">camera</span><span>.</span><span class="text-codex-syntax-attribute">position</span><span>.</span><span class="text-codex-syntax-variable">copy</span><span>(</span><span class="text-codex-syntax-variable">playerPosition</span><span>);

    </span><span class="text-codex-syntax-variable">camera</span><span>.</span><span class="text-codex-syntax-attribute">rotation</span><span>.</span><span class="text-codex-syntax-attribute">order </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-string">"YXZ"</span><span>;
    </span><span class="text-codex-syntax-variable">camera</span><span>.</span><span class="text-codex-syntax-attribute">rotation</span><span>.</span><span class="text-codex-syntax-attribute">y </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">yaw</span><span>;
    </span><span class="text-codex-syntax-variable">camera</span><span>.</span><span class="text-codex-syntax-attribute">rotation</span><span>.</span><span class="text-codex-syntax-attribute">x </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">pitch</span><span>;

}


</span><span class="Comment-dh5VVn">/* =========================================================</span><span>
</span><span class="Comment-dh5VVn">   18. MOUSE LOOK</span><span>
</span><span class="Comment-dh5VVn">========================================================= */</span><span>

</span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">gameCanvasContainer </span><span class="text-codex-syntax-keyword">=</span><span>
</span><span class="text-codex-syntax-keyword">    </span><span class="text-codex-syntax-variable">document</span><span>.</span><span class="text-codex-syntax-variable">getElementById</span><span>(</span><span class="text-codex-syntax-string">"three-container"</span><span>);

</span><span class="text-codex-syntax-variable">gameCanvasContainer</span><span>.</span><span class="text-codex-syntax-variable">addEventListener</span><span>(</span><span class="text-codex-syntax-string">"click"</span><span>, () </span><span class="text-codex-syntax-keyword">=&gt; </span><span>{

    </span><span class="text-codex-syntax-keyword">if </span><span>(</span><span class="text-codex-syntax-keyword">!</span><span class="text-codex-syntax-variable">isExploring </span><span class="text-codex-syntax-keyword">|| </span><span class="text-codex-syntax-variable">isPaused</span><span>) </span><span class="text-codex-syntax-keyword">return</span><span>;

    </span><span class="text-codex-syntax-keyword">if </span><span>(</span><span class="text-codex-syntax-variable">document</span><span>.</span><span class="text-codex-syntax-attribute">pointerLockElement </span><span class="text-codex-syntax-keyword">!== </span><span class="text-codex-syntax-variable">gameCanvasContainer</span><span>) {
        </span><span class="text-codex-syntax-variable">gameCanvasContainer</span><span>.</span><span class="text-codex-syntax-variable">requestPointerLock</span><span>();
    }

});

</span><span class="text-codex-syntax-variable">document</span><span>.</span><span class="text-codex-syntax-variable">addEventListener</span><span>(</span><span class="text-codex-syntax-string">"mousemove"</span><span>, </span><span class="text-codex-syntax-variable">event </span><span class="text-codex-syntax-keyword">=&gt; </span><span>{

    </span><span class="text-codex-syntax-keyword">if </span><span>(</span><span class="text-codex-syntax-variable">document</span><span>.</span><span class="text-codex-syntax-attribute">pointerLockElement </span><span class="text-codex-syntax-keyword">!== </span><span class="text-codex-syntax-variable">gameCanvasContainer</span><span>) </span><span class="text-codex-syntax-keyword">return</span><span>;

    </span><span class="text-codex-syntax-variable">yaw </span><span class="text-codex-syntax-keyword">-= </span><span class="text-codex-syntax-variable">event</span><span>.</span><span class="text-codex-syntax-attribute">movementX </span><span class="text-codex-syntax-keyword">* </span><span class="text-codex-syntax-literal">0.002</span><span>;
    </span><span class="text-codex-syntax-variable">pitch </span><span class="text-codex-syntax-keyword">-= </span><span class="text-codex-syntax-variable">event</span><span>.</span><span class="text-codex-syntax-attribute">movementY </span><span class="text-codex-syntax-keyword">* </span><span class="text-codex-syntax-literal">0.002</span><span>;

    </span><span class="text-codex-syntax-variable">pitch </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-literal">THREE</span><span>.</span><span class="text-codex-syntax-attribute">MathUtils</span><span>.</span><span class="text-codex-syntax-variable">clamp</span><span>(
        </span><span class="text-codex-syntax-variable">pitch</span><span>,
        </span><span class="text-codex-syntax-keyword">-</span><span class="text-codex-syntax-literal">1.3</span><span>,
        </span><span class="text-codex-syntax-literal">1.3</span><span>
</span><span class="text-codex-syntax-literal">    </span><span>);

});


</span><span class="text-codex-syntax-variable">document</span><span>.</span><span class="text-codex-syntax-variable">addEventListener</span><span>(</span><span class="text-codex-syntax-string">"pointerlockchange"</span><span>, () </span><span class="text-codex-syntax-keyword">=&gt; </span><span>{

    </span><span class="text-codex-syntax-keyword">if </span><span>(</span><span class="text-codex-syntax-keyword">!</span><span class="text-codex-syntax-variable">isExploring</span><span>) </span><span class="text-codex-syntax-keyword">return</span><span>;

    </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">locked </span><span class="text-codex-syntax-keyword">=</span><span>
</span><span class="text-codex-syntax-keyword">        </span><span class="text-codex-syntax-variable">document</span><span>.</span><span class="text-codex-syntax-attribute">pointerLockElement </span><span class="text-codex-syntax-keyword">=== </span><span class="text-codex-syntax-variable">gameCanvasContainer</span><span>;

    </span><span class="text-codex-syntax-variable">isPaused </span><span class="text-codex-syntax-keyword">= !</span><span class="text-codex-syntax-variable">locked</span><span>;

    </span><span class="text-codex-syntax-variable">document</span><span>.</span><span class="text-codex-syntax-variable">getElementById</span><span>(</span><span class="text-codex-syntax-string">"pause-message"</span><span>)
        .</span><span class="text-codex-syntax-attribute">classList</span><span>.</span><span class="text-codex-syntax-variable">toggle</span><span>(</span><span class="text-codex-syntax-string">"show"</span><span>, </span><span class="text-codex-syntax-keyword">!</span><span class="text-codex-syntax-variable">locked</span><span>);

});


</span><span class="text-codex-syntax-variable">document</span><span>.</span><span class="text-codex-syntax-variable">getElementById</span><span>(</span><span class="text-codex-syntax-string">"pause-message"</span><span>).</span><span class="text-codex-syntax-variable">addEventListener</span><span>(</span><span class="text-codex-syntax-string">"click"</span><span>, () </span><span class="text-codex-syntax-keyword">=&gt; </span><span>{

    </span><span class="text-codex-syntax-keyword">if </span><span>(</span><span class="text-codex-syntax-variable">isExploring </span><span class="text-codex-syntax-keyword">&amp;&amp; !</span><span class="text-codex-syntax-variable">isPaused</span><span>) </span><span class="text-codex-syntax-keyword">return</span><span>;

    </span><span class="text-codex-syntax-variable">gameCanvasContainer</span><span>.</span><span class="text-codex-syntax-variable">requestPointerLock</span><span>();

});


</span><span class="Comment-dh5VVn">/* =========================================================</span><span>
</span><span class="Comment-dh5VVn">   19. DISCOVERY DETECTION</span><span>
</span><span class="Comment-dh5VVn">========================================================= */</span><span>

</span><span class="text-codex-syntax-keyword">function </span><span class="text-codex-syntax-variable">checkNearbyDiscoveries</span><span>() {

    </span><span class="text-codex-syntax-keyword">if </span><span>(</span><span class="text-codex-syntax-keyword">!</span><span class="text-codex-syntax-variable">camera </span><span class="text-codex-syntax-keyword">|| !</span><span class="text-codex-syntax-variable">isExploring </span><span class="text-codex-syntax-keyword">|| </span><span class="text-codex-syntax-variable">isPaused</span><span>) </span><span class="text-codex-syntax-keyword">return</span><span>;

    </span><span class="text-codex-syntax-variable">activeDiscovery </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-literal">null</span><span>;

    </span><span class="text-codex-syntax-keyword">let </span><span class="text-codex-syntax-variable">closestDistance </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-literal">4</span><span>;

    </span><span class="text-codex-syntax-variable">discoveries</span><span>.</span><span class="text-codex-syntax-variable">forEach</span><span>(</span><span class="text-codex-syntax-variable">discovery </span><span class="text-codex-syntax-keyword">=&gt; </span><span>{

        </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">index </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">discovery</span><span>.</span><span class="text-codex-syntax-attribute">userData</span><span>.</span><span class="text-codex-syntax-attribute">discoveryIndex</span><span>;

        </span><span class="text-codex-syntax-keyword">if </span><span>(</span><span class="text-codex-syntax-variable">foundDiscoveries</span><span>.</span><span class="text-codex-syntax-variable">includes</span><span>(</span><span class="text-codex-syntax-variable">index</span><span>)) </span><span class="text-codex-syntax-keyword">return</span><span>;

        </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">distance </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">camera</span><span>.</span><span class="text-codex-syntax-attribute">position</span><span>.</span><span class="text-codex-syntax-variable">distanceTo</span><span>(
            </span><span class="text-codex-syntax-variable">discovery</span><span>.</span><span class="text-codex-syntax-attribute">position</span><span>
</span><span class="text-codex-syntax-attribute">        </span><span>);

        </span><span class="text-codex-syntax-keyword">if </span><span>(</span><span class="text-codex-syntax-variable">distance </span><span class="text-codex-syntax-keyword">&lt; </span><span class="text-codex-syntax-variable">closestDistance</span><span>) {

            </span><span class="text-codex-syntax-variable">closestDistance </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">distance</span><span>;
            </span><span class="text-codex-syntax-variable">activeDiscovery </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">discovery</span><span>;

        }

    });

    </span><span class="text-codex-syntax-variable">document</span><span>.</span><span class="text-codex-syntax-variable">getElementById</span><span>(</span><span class="text-codex-syntax-string">"interaction-prompt"</span><span>).</span><span class="text-codex-syntax-attribute">style</span><span>.</span><span class="text-codex-syntax-attribute">display </span><span class="text-codex-syntax-keyword">=</span><span>
</span><span class="text-codex-syntax-keyword">        </span><span class="text-codex-syntax-variable">activeDiscovery </span><span class="text-codex-syntax-keyword">? </span><span class="text-codex-syntax-string">"block" </span><span>: </span><span class="text-codex-syntax-string">"none"</span><span>;

}


</span><span class="Comment-dh5VVn">/* =========================================================</span><span>
</span><span class="Comment-dh5VVn">   20. INVESTIGATE</span><span>
</span><span class="Comment-dh5VVn">========================================================= */</span><span>

</span><span class="text-codex-syntax-keyword">function </span><span class="text-codex-syntax-variable">investigate</span><span>() {

    </span><span class="text-codex-syntax-keyword">if </span><span>(</span><span class="text-codex-syntax-keyword">!</span><span class="text-codex-syntax-variable">activeDiscovery </span><span class="text-codex-syntax-keyword">|| </span><span class="text-codex-syntax-variable">isPaused </span><span class="text-codex-syntax-keyword">|| !</span><span class="text-codex-syntax-variable">isExploring</span><span>) </span><span class="text-codex-syntax-keyword">return</span><span>;

    </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">index </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">activeDiscovery</span><span>.</span><span class="text-codex-syntax-attribute">userData</span><span>.</span><span class="text-codex-syntax-attribute">discoveryIndex</span><span>;

    </span><span class="text-codex-syntax-keyword">if </span><span>(</span><span class="text-codex-syntax-variable">foundDiscoveries</span><span>.</span><span class="text-codex-syntax-variable">includes</span><span>(</span><span class="text-codex-syntax-variable">index</span><span>)) </span><span class="text-codex-syntax-keyword">return</span><span>;

    </span><span class="text-codex-syntax-variable">foundDiscoveries</span><span>.</span><span class="text-codex-syntax-variable">push</span><span>(</span><span class="text-codex-syntax-variable">index</span><span>);

    </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">data </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">activeDiscovery</span><span>.</span><span class="text-codex-syntax-attribute">userData</span><span>.</span><span class="text-codex-syntax-attribute">discoveryData</span><span>;

    </span><span class="text-codex-syntax-variable">document</span><span>.</span><span class="text-codex-syntax-variable">getElementById</span><span>(</span><span class="text-codex-syntax-string">"discovery-title"</span><span>).</span><span class="text-codex-syntax-attribute">textContent </span><span class="text-codex-syntax-keyword">=</span><span>
</span><span class="text-codex-syntax-keyword">        </span><span class="text-codex-syntax-variable">data</span><span>.</span><span class="text-codex-syntax-attribute">name</span><span>;

    </span><span class="text-codex-syntax-variable">document</span><span>.</span><span class="text-codex-syntax-variable">getElementById</span><span>(</span><span class="text-codex-syntax-string">"discovery-description"</span><span>).</span><span class="text-codex-syntax-attribute">textContent </span><span class="text-codex-syntax-keyword">=</span><span>
</span><span class="text-codex-syntax-keyword">        </span><span class="text-codex-syntax-variable">data</span><span>.</span><span class="text-codex-syntax-attribute">description</span><span>;

    </span><span class="text-codex-syntax-variable">document</span><span>.</span><span class="text-codex-syntax-variable">getElementById</span><span>(</span><span class="text-codex-syntax-string">"discovery-message"</span><span>)
        .</span><span class="text-codex-syntax-attribute">classList</span><span>.</span><span class="text-codex-syntax-variable">add</span><span>(</span><span class="text-codex-syntax-string">"show"</span><span>);

    </span><span class="text-codex-syntax-variable">document</span><span>.</span><span class="text-codex-syntax-variable">getElementById</span><span>(</span><span class="text-codex-syntax-string">"interaction-prompt"</span><span>).</span><span class="text-codex-syntax-attribute">style</span><span>.</span><span class="text-codex-syntax-attribute">display </span><span class="text-codex-syntax-keyword">=</span><span>
</span><span class="text-codex-syntax-keyword">        </span><span class="text-codex-syntax-string">"none"</span><span>;

    </span><span class="text-codex-syntax-variable">activeDiscovery</span><span>.</span><span class="text-codex-syntax-attribute">visible </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-literal">false</span><span>;

    </span><span class="text-codex-syntax-variable">updateProgress</span><span>();

}


</span><span class="text-codex-syntax-variable">document</span><span>.</span><span class="text-codex-syntax-variable">getElementById</span><span>(</span><span class="text-codex-syntax-string">"close-discovery"</span><span>).</span><span class="text-codex-syntax-variable">addEventListener</span><span>(</span><span class="text-codex-syntax-string">"click"</span><span>, () </span><span class="text-codex-syntax-keyword">=&gt; </span><span>{

    </span><span class="text-codex-syntax-variable">document</span><span>.</span><span class="text-codex-syntax-variable">getElementById</span><span>(</span><span class="text-codex-syntax-string">"discovery-message"</span><span>)
        .</span><span class="text-codex-syntax-attribute">classList</span><span>.</span><span class="text-codex-syntax-variable">remove</span><span>(</span><span class="text-codex-syntax-string">"show"</span><span>);

    </span><span class="text-codex-syntax-keyword">if </span><span>(</span><span class="text-codex-syntax-variable">foundDiscoveries</span><span>.</span><span class="text-codex-syntax-attribute">length </span><span class="text-codex-syntax-keyword">=== </span><span class="text-codex-syntax-variable">selectedMission</span><span>.</span><span class="text-codex-syntax-attribute">discoveries</span><span>.</span><span class="text-codex-syntax-attribute">length</span><span>) {
        </span><span class="text-codex-syntax-variable">completeMission</span><span>();
    }

});


</span><span class="Comment-dh5VVn">/* =========================================================</span><span>
</span><span class="Comment-dh5VVn">   21. PROGRESS</span><span>
</span><span class="Comment-dh5VVn">========================================================= */</span><span>

</span><span class="text-codex-syntax-keyword">function </span><span class="text-codex-syntax-variable">updateProgress</span><span>() {

    </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">total </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">selectedMission</span><span>.</span><span class="text-codex-syntax-attribute">discoveries</span><span>.</span><span class="text-codex-syntax-attribute">length</span><span>;
    </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">current </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">foundDiscoveries</span><span>.</span><span class="text-codex-syntax-attribute">length</span><span>;

    </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">percentage </span><span class="text-codex-syntax-keyword">= </span><span>(</span><span class="text-codex-syntax-variable">current </span><span class="text-codex-syntax-keyword">/ </span><span class="text-codex-syntax-variable">total</span><span>) </span><span class="text-codex-syntax-keyword">* </span><span class="text-codex-syntax-literal">100</span><span>;

    </span><span class="text-codex-syntax-variable">document</span><span>.</span><span class="text-codex-syntax-variable">getElementById</span><span>(</span><span class="text-codex-syntax-string">"objective-progress"</span><span>).</span><span class="text-codex-syntax-attribute">textContent </span><span class="text-codex-syntax-keyword">=</span><span>
</span><span class="text-codex-syntax-keyword">        </span><span class="text-codex-syntax-variable">current </span><span class="text-codex-syntax-keyword">+ </span><span class="text-codex-syntax-string">" / " </span><span class="text-codex-syntax-keyword">+ </span><span class="text-codex-syntax-variable">total </span><span class="text-codex-syntax-keyword">+ </span><span class="text-codex-syntax-string">" DISCOVERIES"</span><span>;

    </span><span class="text-codex-syntax-variable">document</span><span>.</span><span class="text-codex-syntax-variable">getElementById</span><span>(</span><span class="text-codex-syntax-string">"progress-fill"</span><span>).</span><span class="text-codex-syntax-attribute">style</span><span>.</span><span class="text-codex-syntax-attribute">width </span><span class="text-codex-syntax-keyword">=</span><span>
</span><span class="text-codex-syntax-keyword">        </span><span class="text-codex-syntax-variable">percentage </span><span class="text-codex-syntax-keyword">+ </span><span class="text-codex-syntax-string">"%"</span><span>;

}


</span><span class="Comment-dh5VVn">/* =========================================================</span><span>
</span><span class="Comment-dh5VVn">   22. MINIMAP</span><span>
</span><span class="Comment-dh5VVn">========================================================= */</span><span>

</span><span class="text-codex-syntax-keyword">function </span><span class="text-codex-syntax-variable">drawMap</span><span>() {

    </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">canvas </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">document</span><span>.</span><span class="text-codex-syntax-variable">getElementById</span><span>(</span><span class="text-codex-syntax-string">"map-canvas"</span><span>);
    </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">ctx </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">canvas</span><span>.</span><span class="text-codex-syntax-variable">getContext</span><span>(</span><span class="text-codex-syntax-string">"2d"</span><span>);

    </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">width </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">canvas</span><span>.</span><span class="text-codex-syntax-attribute">width</span><span>;
    </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">height </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">canvas</span><span>.</span><span class="text-codex-syntax-attribute">height</span><span>;

    </span><span class="text-codex-syntax-variable">ctx</span><span>.</span><span class="text-codex-syntax-variable">clearRect</span><span>(</span><span class="text-codex-syntax-literal">0</span><span>, </span><span class="text-codex-syntax-literal">0</span><span>, </span><span class="text-codex-syntax-variable">width</span><span>, </span><span class="text-codex-syntax-variable">height</span><span>);

    </span><span class="text-codex-syntax-variable">ctx</span><span>.</span><span class="text-codex-syntax-attribute">fillStyle </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-string">"rgba(15,25,38,0.95)"</span><span>;
    </span><span class="text-codex-syntax-variable">ctx</span><span>.</span><span class="text-codex-syntax-variable">fillRect</span><span>(</span><span class="text-codex-syntax-literal">0</span><span>, </span><span class="text-codex-syntax-literal">0</span><span>, </span><span class="text-codex-syntax-variable">width</span><span>, </span><span class="text-codex-syntax-variable">height</span><span>);

    </span><span class="text-codex-syntax-variable">ctx</span><span>.</span><span class="text-codex-syntax-attribute">strokeStyle </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-string">"rgba(85,200,255,0.18)"</span><span>;
    </span><span class="text-codex-syntax-variable">ctx</span><span>.</span><span class="text-codex-syntax-attribute">lineWidth </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-literal">1</span><span>;

    </span><span class="text-codex-syntax-keyword">for </span><span>(</span><span class="text-codex-syntax-keyword">let </span><span class="text-codex-syntax-variable">i </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-literal">0</span><span>; </span><span class="text-codex-syntax-variable">i </span><span class="text-codex-syntax-keyword">&lt;= </span><span class="text-codex-syntax-variable">width</span><span>; </span><span class="text-codex-syntax-variable">i </span><span class="text-codex-syntax-keyword">+= </span><span class="text-codex-syntax-literal">30</span><span>) {
        </span><span class="text-codex-syntax-variable">ctx</span><span>.</span><span class="text-codex-syntax-variable">beginPath</span><span>();
        </span><span class="text-codex-syntax-variable">ctx</span><span>.</span><span class="text-codex-syntax-variable">moveTo</span><span>(</span><span class="text-codex-syntax-variable">i</span><span>, </span><span class="text-codex-syntax-literal">0</span><span>);
        </span><span class="text-codex-syntax-variable">ctx</span><span>.</span><span class="text-codex-syntax-variable">lineTo</span><span>(</span><span class="text-codex-syntax-variable">i</span><span>, </span><span class="text-codex-syntax-variable">height</span><span>);
        </span><span class="text-codex-syntax-variable">ctx</span><span>.</span><span class="text-codex-syntax-variable">stroke</span><span>();

        </span><span class="text-codex-syntax-variable">ctx</span><span>.</span><span class="text-codex-syntax-variable">beginPath</span><span>();
        </span><span class="text-codex-syntax-variable">ctx</span><span>.</span><span class="text-codex-syntax-variable">moveTo</span><span>(</span><span class="text-codex-syntax-literal">0</span><span>, </span><span class="text-codex-syntax-variable">i</span><span>);
        </span><span class="text-codex-syntax-variable">ctx</span><span>.</span><span class="text-codex-syntax-variable">lineTo</span><span>(</span><span class="text-codex-syntax-variable">width</span><span>, </span><span class="text-codex-syntax-variable">i</span><span>);
        </span><span class="text-codex-syntax-variable">ctx</span><span>.</span><span class="text-codex-syntax-variable">stroke</span><span>();
    }

    </span><span class="text-codex-syntax-keyword">if </span><span>(</span><span class="text-codex-syntax-keyword">!</span><span class="text-codex-syntax-variable">playerPosition</span><span>) </span><span class="text-codex-syntax-keyword">return</span><span>;

    </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">playerX </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">width </span><span class="text-codex-syntax-keyword">/ </span><span class="text-codex-syntax-literal">2 </span><span class="text-codex-syntax-keyword">+ </span><span class="text-codex-syntax-variable">playerPosition</span><span>.</span><span class="text-codex-syntax-attribute">x </span><span class="text-codex-syntax-keyword">* </span><span class="text-codex-syntax-literal">0.5</span><span>;
    </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">playerY </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">height </span><span class="text-codex-syntax-keyword">/ </span><span class="text-codex-syntax-literal">2 </span><span class="text-codex-syntax-keyword">+ </span><span class="text-codex-syntax-variable">playerPosition</span><span>.</span><span class="text-codex-syntax-attribute">z </span><span class="text-codex-syntax-keyword">* </span><span class="text-codex-syntax-literal">0.5</span><span>;

    </span><span class="text-codex-syntax-variable">ctx</span><span>.</span><span class="text-codex-syntax-attribute">fillStyle </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-string">"#55c8ff"</span><span>;
    </span><span class="text-codex-syntax-variable">ctx</span><span>.</span><span class="text-codex-syntax-variable">beginPath</span><span>();
    </span><span class="text-codex-syntax-variable">ctx</span><span>.</span><span class="text-codex-syntax-variable">arc</span><span>(</span><span class="text-codex-syntax-variable">playerX</span><span>, </span><span class="text-codex-syntax-variable">playerY</span><span>, </span><span class="text-codex-syntax-literal">4</span><span>, </span><span class="text-codex-syntax-literal">0</span><span>, </span><span class="text-codex-syntax-variable">Math</span><span>.</span><span class="text-codex-syntax-attribute">PI </span><span class="text-codex-syntax-keyword">* </span><span class="text-codex-syntax-literal">2</span><span>);
    </span><span class="text-codex-syntax-variable">ctx</span><span>.</span><span class="text-codex-syntax-variable">fill</span><span>();

    </span><span class="text-codex-syntax-variable">discoveries</span><span>.</span><span class="text-codex-syntax-variable">forEach</span><span>(</span><span class="text-codex-syntax-variable">discovery </span><span class="text-codex-syntax-keyword">=&gt; </span><span>{

        </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">index </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">discovery</span><span>.</span><span class="text-codex-syntax-attribute">userData</span><span>.</span><span class="text-codex-syntax-attribute">discoveryIndex</span><span>;

        </span><span class="text-codex-syntax-keyword">if </span><span>(</span><span class="text-codex-syntax-variable">foundDiscoveries</span><span>.</span><span class="text-codex-syntax-variable">includes</span><span>(</span><span class="text-codex-syntax-variable">index</span><span>)) </span><span class="text-codex-syntax-keyword">return</span><span>;

        </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">x </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">width </span><span class="text-codex-syntax-keyword">/ </span><span class="text-codex-syntax-literal">2 </span><span class="text-codex-syntax-keyword">+ </span><span class="text-codex-syntax-variable">discovery</span><span>.</span><span class="text-codex-syntax-attribute">position</span><span>.</span><span class="text-codex-syntax-attribute">x </span><span class="text-codex-syntax-keyword">* </span><span class="text-codex-syntax-literal">0.5</span><span>;
        </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">y </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">height </span><span class="text-codex-syntax-keyword">/ </span><span class="text-codex-syntax-literal">2 </span><span class="text-codex-syntax-keyword">+ </span><span class="text-codex-syntax-variable">discovery</span><span>.</span><span class="text-codex-syntax-attribute">position</span><span>.</span><span class="text-codex-syntax-attribute">z </span><span class="text-codex-syntax-keyword">* </span><span class="text-codex-syntax-literal">0.5</span><span>;

        </span><span class="text-codex-syntax-variable">ctx</span><span>.</span><span class="text-codex-syntax-attribute">fillStyle </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-string">"#ffb36a"</span><span>;
        </span><span class="text-codex-syntax-variable">ctx</span><span>.</span><span class="text-codex-syntax-variable">beginPath</span><span>();
        </span><span class="text-codex-syntax-variable">ctx</span><span>.</span><span class="text-codex-syntax-variable">arc</span><span>(</span><span class="text-codex-syntax-variable">x</span><span>, </span><span class="text-codex-syntax-variable">y</span><span>, </span><span class="text-codex-syntax-literal">3</span><span>, </span><span class="text-codex-syntax-literal">0</span><span>, </span><span class="text-codex-syntax-variable">Math</span><span>.</span><span class="text-codex-syntax-attribute">PI </span><span class="text-codex-syntax-keyword">* </span><span class="text-codex-syntax-literal">2</span><span>);
        </span><span class="text-codex-syntax-variable">ctx</span><span>.</span><span class="text-codex-syntax-variable">fill</span><span>();

    });

}


</span><span class="Comment-dh5VVn">/* =========================================================</span><span>
</span><span class="Comment-dh5VVn">   23. COMPLETE MISSION</span><span>
</span><span class="Comment-dh5VVn">========================================================= */</span><span>

</span><span class="text-codex-syntax-keyword">function </span><span class="text-codex-syntax-variable">completeMission</span><span>() {

    </span><span class="text-codex-syntax-variable">isExploring </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-literal">false</span><span>;

    </span><span class="text-codex-syntax-keyword">if </span><span>(</span><span class="text-codex-syntax-variable">document</span><span>.</span><span class="text-codex-syntax-attribute">pointerLockElement</span><span>) {
        </span><span class="text-codex-syntax-variable">document</span><span>.</span><span class="text-codex-syntax-variable">exitPointerLock</span><span>();
    }

    </span><span class="text-codex-syntax-variable">document</span><span>.</span><span class="text-codex-syntax-variable">getElementById</span><span>(</span><span class="text-codex-syntax-string">"complete-mission-name"</span><span>).</span><span class="text-codex-syntax-attribute">textContent </span><span class="text-codex-syntax-keyword">=</span><span>
</span><span class="text-codex-syntax-keyword">        </span><span class="text-codex-syntax-variable">selectedMission</span><span>.</span><span class="text-codex-syntax-attribute">name</span><span>;

    </span><span class="text-codex-syntax-variable">document</span><span>.</span><span class="text-codex-syntax-variable">getElementById</span><span>(</span><span class="text-codex-syntax-string">"complete-discoveries"</span><span>).</span><span class="text-codex-syntax-attribute">textContent </span><span class="text-codex-syntax-keyword">=</span><span>
</span><span class="text-codex-syntax-keyword">        </span><span class="text-codex-syntax-variable">foundDiscoveries</span><span>.</span><span class="text-codex-syntax-attribute">length </span><span class="text-codex-syntax-keyword">+ </span><span class="text-codex-syntax-string">" / " </span><span class="text-codex-syntax-keyword">+</span><span>
</span><span class="text-codex-syntax-keyword">        </span><span class="text-codex-syntax-variable">selectedMission</span><span>.</span><span class="text-codex-syntax-attribute">discoveries</span><span>.</span><span class="text-codex-syntax-attribute">length</span><span>;

    </span><span class="text-codex-syntax-variable">document</span><span>.</span><span class="text-codex-syntax-variable">getElementById</span><span>(</span><span class="text-codex-syntax-string">"complete-description"</span><span>).</span><span class="text-codex-syntax-attribute">textContent </span><span class="text-codex-syntax-keyword">=</span><span>
</span><span class="text-codex-syntax-keyword">        </span><span class="text-codex-syntax-string">"You have investigated the environment and completed all objectives. Your discoveries have been added to the NOVA mission report."</span><span>;

    </span><span class="text-codex-syntax-variable">showScreen</span><span>(</span><span class="text-codex-syntax-string">"complete-screen"</span><span>);

    </span><span class="text-codex-syntax-variable">cancelAnimationFrame</span><span>(</span><span class="text-codex-syntax-variable">animationFrame</span><span>);

}


</span><span class="Comment-dh5VVn">/* =========================================================</span><span>
</span><span class="Comment-dh5VVn">   24. EXIT MISSION</span><span>
</span><span class="Comment-dh5VVn">========================================================= */</span><span>

</span><span class="text-codex-syntax-variable">document</span><span>.</span><span class="text-codex-syntax-variable">getElementById</span><span>(</span><span class="text-codex-syntax-string">"exit-exploration"</span><span>).</span><span class="text-codex-syntax-variable">addEventListener</span><span>(</span><span class="text-codex-syntax-string">"click"</span><span>, () </span><span class="text-codex-syntax-keyword">=&gt; </span><span>{

    </span><span class="text-codex-syntax-variable">isExploring </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-literal">false</span><span>;

    </span><span class="text-codex-syntax-keyword">if </span><span>(</span><span class="text-codex-syntax-variable">document</span><span>.</span><span class="text-codex-syntax-attribute">pointerLockElement</span><span>) {
        </span><span class="text-codex-syntax-variable">document</span><span>.</span><span class="text-codex-syntax-variable">exitPointerLock</span><span>();
    }

    </span><span class="text-codex-syntax-variable">cancelAnimationFrame</span><span>(</span><span class="text-codex-syntax-variable">animationFrame</span><span>);

    </span><span class="text-codex-syntax-variable">showScreen</span><span>(</span><span class="text-codex-syntax-string">"briefing-screen"</span><span>);

});


</span><span class="text-codex-syntax-variable">document</span><span>.</span><span class="text-codex-syntax-variable">getElementById</span><span>(</span><span class="text-codex-syntax-string">"return-home"</span><span>).</span><span class="text-codex-syntax-variable">addEventListener</span><span>(</span><span class="text-codex-syntax-string">"click"</span><span>, () </span><span class="text-codex-syntax-keyword">=&gt; </span><span>{

    </span><span class="text-codex-syntax-variable">isExploring </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-literal">false</span><span>;

    </span><span class="text-codex-syntax-variable">cancelAnimationFrame</span><span>(</span><span class="text-codex-syntax-variable">animationFrame</span><span>);

    </span><span class="text-codex-syntax-variable">showScreen</span><span>(</span><span class="text-codex-syntax-string">"home-screen"</span><span>);

});


</span><span class="Comment-dh5VVn">/* =========================================================</span><span>
</span><span class="Comment-dh5VVn">   25. ANIMATION LOOP</span><span>
</span><span class="Comment-dh5VVn">========================================================= */</span><span>

</span><span class="text-codex-syntax-keyword">function </span><span class="text-codex-syntax-variable">animate</span><span>() {

    </span><span class="text-codex-syntax-keyword">if </span><span>(</span><span class="text-codex-syntax-keyword">!</span><span class="text-codex-syntax-variable">isExploring</span><span>) </span><span class="text-codex-syntax-keyword">return</span><span>;

    </span><span class="text-codex-syntax-variable">animationFrame </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">requestAnimationFrame</span><span>(</span><span class="text-codex-syntax-variable">animate</span><span>);

    </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">delta </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">Math</span><span>.</span><span class="text-codex-syntax-variable">min</span><span>(</span><span class="text-codex-syntax-variable">clock</span><span>.</span><span class="text-codex-syntax-variable">getDelta</span><span>(), </span><span class="text-codex-syntax-literal">0.05</span><span>);

    </span><span class="text-codex-syntax-keyword">if </span><span>(</span><span class="text-codex-syntax-keyword">!</span><span class="text-codex-syntax-variable">isPaused</span><span>) {

        </span><span class="text-codex-syntax-variable">updateMovement</span><span>(</span><span class="text-codex-syntax-variable">delta</span><span>);
        </span><span class="text-codex-syntax-variable">checkNearbyDiscoveries</span><span>();

        </span><span class="text-codex-syntax-variable">discoveries</span><span>.</span><span class="text-codex-syntax-variable">forEach</span><span>((</span><span class="text-codex-syntax-variable">discovery</span><span>, </span><span class="text-codex-syntax-variable">index</span><span>) </span><span class="text-codex-syntax-keyword">=&gt; </span><span>{

            </span><span class="text-codex-syntax-keyword">if </span><span>(</span><span class="text-codex-syntax-variable">discovery</span><span>.</span><span class="text-codex-syntax-attribute">visible</span><span>) {

                </span><span class="text-codex-syntax-variable">discovery</span><span>.</span><span class="text-codex-syntax-attribute">rotation</span><span>.</span><span class="text-codex-syntax-attribute">y </span><span class="text-codex-syntax-keyword">+= </span><span class="text-codex-syntax-variable">delta </span><span class="text-codex-syntax-keyword">* </span><span class="text-codex-syntax-literal">0.8</span><span>;

                </span><span class="text-codex-syntax-variable">discovery</span><span>.</span><span class="text-codex-syntax-attribute">position</span><span>.</span><span class="text-codex-syntax-attribute">y </span><span class="text-codex-syntax-keyword">=</span><span>
</span><span class="text-codex-syntax-keyword">                    </span><span class="text-codex-syntax-literal">1.5 </span><span class="text-codex-syntax-keyword">+ </span><span class="text-codex-syntax-variable">Math</span><span>.</span><span class="text-codex-syntax-variable">sin</span><span>(</span><span class="text-codex-syntax-variable">Date</span><span>.</span><span class="text-codex-syntax-variable">now</span><span>() </span><span class="text-codex-syntax-keyword">* </span><span class="text-codex-syntax-literal">0.002 </span><span class="text-codex-syntax-keyword">+ </span><span class="text-codex-syntax-variable">index</span><span>) </span><span class="text-codex-syntax-keyword">* </span><span class="text-codex-syntax-literal">0.2</span><span>;

            }

        });

        </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">ingenuity </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">scene</span><span>.</span><span class="text-codex-syntax-attribute">userData</span><span>.</span><span class="text-codex-syntax-attribute">ingenuity</span><span>;

        </span><span class="text-codex-syntax-keyword">if </span><span>(</span><span class="text-codex-syntax-variable">ingenuity</span><span>) {

            </span><span class="text-codex-syntax-keyword">if </span><span>(</span><span class="text-codex-syntax-variable">ingenuity</span><span>.</span><span class="text-codex-syntax-attribute">userData</span><span>.</span><span class="text-codex-syntax-attribute">rotor1</span><span>) {
                </span><span class="text-codex-syntax-variable">ingenuity</span><span>.</span><span class="text-codex-syntax-attribute">userData</span><span>.</span><span class="text-codex-syntax-attribute">rotor1</span><span>.</span><span class="text-codex-syntax-attribute">rotation</span><span>.</span><span class="text-codex-syntax-attribute">y </span><span class="text-codex-syntax-keyword">+= </span><span class="text-codex-syntax-variable">delta </span><span class="text-codex-syntax-keyword">* </span><span class="text-codex-syntax-literal">8</span><span>;
            }

            </span><span class="text-codex-syntax-keyword">if </span><span>(</span><span class="text-codex-syntax-variable">ingenuity</span><span>.</span><span class="text-codex-syntax-attribute">userData</span><span>.</span><span class="text-codex-syntax-attribute">rotor2</span><span>) {
                </span><span class="text-codex-syntax-variable">ingenuity</span><span>.</span><span class="text-codex-syntax-attribute">userData</span><span>.</span><span class="text-codex-syntax-attribute">rotor2</span><span>.</span><span class="text-codex-syntax-attribute">rotation</span><span>.</span><span class="text-codex-syntax-attribute">x </span><span class="text-codex-syntax-keyword">+= </span><span class="text-codex-syntax-variable">delta </span><span class="text-codex-syntax-keyword">* </span><span class="text-codex-syntax-literal">8</span><span>;
            }

        }

    }

    </span><span class="text-codex-syntax-keyword">if </span><span>(</span><span class="text-codex-syntax-variable">camera</span><span>) {
        </span><span class="text-codex-syntax-variable">camera</span><span>.</span><span class="text-codex-syntax-attribute">position</span><span>.</span><span class="text-codex-syntax-variable">copy</span><span>(</span><span class="text-codex-syntax-variable">playerPosition</span><span>);
    }

    </span><span class="text-codex-syntax-variable">drawMap</span><span>();

    </span><span class="text-codex-syntax-variable">renderer</span><span>.</span><span class="text-codex-syntax-variable">render</span><span>(</span><span class="text-codex-syntax-variable">scene</span><span>, </span><span class="text-codex-syntax-variable">camera</span><span>);

}


</span><span class="Comment-dh5VVn">/* =========================================================</span><span>
</span><span class="Comment-dh5VVn">   26. WINDOW RESIZE</span><span>
</span><span class="Comment-dh5VVn">========================================================= */</span><span>

</span><span class="text-codex-syntax-variable">window</span><span>.</span><span class="text-codex-syntax-variable">addEventListener</span><span>(</span><span class="text-codex-syntax-string">"resize"</span><span>, () </span><span class="text-codex-syntax-keyword">=&gt; </span><span>{

    </span><span class="text-codex-syntax-keyword">if </span><span>(</span><span class="text-codex-syntax-keyword">!</span><span class="text-codex-syntax-variable">camera </span><span class="text-codex-syntax-keyword">|| !</span><span class="text-codex-syntax-variable">renderer</span><span>) </span><span class="text-codex-syntax-keyword">return</span><span>;

    </span><span class="text-codex-syntax-variable">camera</span><span>.</span><span class="text-codex-syntax-attribute">aspect </span><span class="text-codex-syntax-keyword">=</span><span>
</span><span class="text-codex-syntax-keyword">        </span><span class="text-codex-syntax-variable">window</span><span>.</span><span class="text-codex-syntax-attribute">innerWidth </span><span class="text-codex-syntax-keyword">/ </span><span class="text-codex-syntax-variable">window</span><span>.</span><span class="text-codex-syntax-attribute">innerHeight</span><span>;

    </span><span class="text-codex-syntax-variable">camera</span><span>.</span><span class="text-codex-syntax-variable">updateProjectionMatrix</span><span>();

    </span><span class="text-codex-syntax-variable">renderer</span><span>.</span><span class="text-codex-syntax-variable">setSize</span><span>(
        </span><span class="text-codex-syntax-variable">window</span><span>.</span><span class="text-codex-syntax-attribute">innerWidth</span><span>,
