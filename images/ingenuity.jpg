</span><span class="text-codex-syntax-keyword">let </span><span class="text-codex-syntax-variable">isExploring </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-literal">false</span><span>;
</span><span class="text-codex-syntax-keyword">let </span><span class="text-codex-syntax-variable">isPaused </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-literal">false</span><span>;

