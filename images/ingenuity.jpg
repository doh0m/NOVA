            &lt;</span><span class="text-codex-syntax-name">h3 </span><span class="text-codex-syntax-attribute">id</span><span>=</span><span class="text-codex-syntax-string">"discovery-title"</span><span>&gt;OBJECT FOUND&lt;/</span><span class="text-codex-syntax-name">h3</span><span>&gt;
            &lt;</span><span class="text-codex-syntax-name">p </span><span class="text-codex-syntax-attribute">id</span><span>=</span><span class="text-codex-syntax-string">"discovery-description"</span><span>&gt;&lt;/</span><span class="text-codex-syntax-name">p</span><span>&gt;
            &lt;</span><span class="text-codex-syntax-name">button </span><span class="text-codex-syntax-attribute">id</span><span>=</span><span class="text-codex-syntax-string">"close-discovery"</span><span>&gt;CONTINUE EXPLORATION&lt;/</span><span class="text-codex-syntax-name">button</span><span>&gt;
        &lt;/</span><span class="text-codex-syntax-name">div</span><span>&gt;

