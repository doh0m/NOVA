</span><span class="text-codex-syntax-literal">    </span><span>});

    </span><span class="text-codex-syntax-variable">addBox</span><span>(</span><span class="text-codex-syntax-variable">group</span><span>, </span><span class="text-codex-syntax-literal">0</span><span>, </span><span class="text-codex-syntax-literal">2.8</span><span>, </span><span class="text-codex-syntax-literal">0</span><span>, </span><span class="text-codex-syntax-literal">4</span><span>, </span><span class="text-codex-syntax-literal">1.8</span><span>, </span><span class="text-codex-syntax-literal">3.5</span><span>, </span><span class="text-codex-syntax-variable">gold</span><span>);

    </span><span class="text-codex-syntax-variable">addBox</span><span>(</span><span class="text-codex-syntax-variable">group</span><span>, </span><span class="text-codex-syntax-literal">0</span><span>, </span><span class="text-codex-syntax-literal">4.3</span><span>, </span><span class="text-codex-syntax-literal">0</span><span>, </span><span class="text-codex-syntax-literal">2.8</span><span>, </span><span class="text-codex-syntax-literal">1.5</span><span>, </span><span class="text-codex-syntax-literal">2.5</span><span>, </span><span class="text-codex-syntax-variable">gold</span><span>);

    </span><span class="text-codex-syntax-variable">addBox</span><span>(</span><span class="text-codex-syntax-variable">group</span><span>, </span><span class="text-codex-syntax-literal">0</span><span>, </span><span class="text-codex-syntax-literal">4.3</span><span>, </span><span class="text-codex-syntax-keyword">-</span><span class="text-codex-syntax-literal">1.3</span><span>, </span><span class="text-codex-syntax-literal">1.2</span><span>, </span><span class="text-codex-syntax-literal">0.8</span><span>, </span><span class="text-codex-syntax-literal">0.1</span><span>, </span><span class="text-codex-syntax-variable">glass</span><span>);

    </span><span class="text-codex-syntax-variable">addCylinder</span><span>(</span><span class="text-codex-syntax-variable">group</span><span>, </span><span class="text-codex-syntax-literal">0</span><span>, </span><span class="text-codex-syntax-literal">1.2</span><span>, </span><span class="text-codex-syntax-literal">0</span><span>, </span><span class="text-codex-syntax-literal">0.5</span><span>, </span><span class="text-codex-syntax-literal">0.7</span><span>, </span><span class="text-codex-syntax-literal">2</span><span>, </span><span class="text-codex-syntax-variable">dark</span><span>);

    </span><span class="text-codex-syntax-keyword">for </span><span>(</span><span class="text-codex-syntax-keyword">let </span><span class="text-codex-syntax-variable">i </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-literal">0</span><span>; </span><span class="text-codex-syntax-variable">i </span><span class="text-codex-syntax-keyword">&lt; </span><span class="text-codex-syntax-literal">4</span><span>; </span><span class="text-codex-syntax-variable">i</span><span class="text-codex-syntax-keyword">++</span><span>) {

        </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">angle </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">i </span><span class="text-codex-syntax-keyword">* </span><span class="text-codex-syntax-variable">Math</span><span>.</span><span class="text-codex-syntax-attribute">PI </span><span class="text-codex-syntax-keyword">/ </span><span class="text-codex-syntax-literal">2</span><span>;

        </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">leg </span><span class="text-codex-syntax-keyword">= new </span><span class="text-codex-syntax-literal">THREE</span><span>.</span><span class="text-codex-syntax-variable">Mesh</span><span>(
            </span><span class="text-codex-syntax-keyword">new </span><span class="text-codex-syntax-literal">THREE</span><span>.</span><span class="text-codex-syntax-variable">CylinderGeometry</span><span>(</span><span class="text-codex-syntax-literal">0.08</span><span>, </span><span class="text-codex-syntax-literal">0.12</span><span>, </span><span class="text-codex-syntax-literal">2.7</span><span>, </span><span class="text-codex-syntax-literal">8</span><span>),
            </span><span class="text-codex-syntax-variable">silver</span><span>
</span><span class="text-codex-syntax-variable">        </span><span>);

        </span><span class="text-codex-syntax-variable">leg</span><span>.</span><span class="text-codex-syntax-attribute">position</span><span>.</span><span class="text-codex-syntax-variable">set</span><span>(
            </span><span class="text-codex-syntax-variable">Math</span><span>.</span><span class="text-codex-syntax-variable">cos</span><span>(</span><span class="text-codex-syntax-variable">angle</span><span>) </span><span class="text-codex-syntax-keyword">* </span><span class="text-codex-syntax-literal">2.3</span><span>,
            </span><span class="text-codex-syntax-literal">1.3</span><span>,
            </span><span class="text-codex-syntax-variable">Math</span><span>.</span><span class="text-codex-syntax-variable">sin</span><span>(</span><span class="text-codex-syntax-variable">angle</span><span>) </span><span class="text-codex-syntax-keyword">* </span><span class="text-codex-syntax-literal">2</span><span>
</span><span class="text-codex-syntax-literal">        </span><span>);

        </span><span class="text-codex-syntax-variable">leg</span><span>.</span><span class="text-codex-syntax-attribute">rotation</span><span>.</span><span class="text-codex-syntax-attribute">z </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">Math</span><span>.</span><span class="text-codex-syntax-variable">cos</span><span>(</span><span class="text-codex-syntax-variable">angle</span><span>) </span><span class="text-codex-syntax-keyword">* </span><span class="text-codex-syntax-literal">0.3</span><span>;
        </span><span class="text-codex-syntax-variable">leg</span><span>.</span><span class="text-codex-syntax-attribute">rotation</span><span>.</span><span class="text-codex-syntax-attribute">x </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">Math</span><span>.</span><span class="text-codex-syntax-variable">sin</span><span>(</span><span class="text-codex-syntax-variable">angle</span><span>) </span><span class="text-codex-syntax-keyword">* </span><span class="text-codex-syntax-literal">0.3</span><span>;

        </span><span class="text-codex-syntax-variable">group</span><span>.</span><span class="text-codex-syntax-variable">add</span><span>(</span><span class="text-codex-syntax-variable">leg</span><span>);

    }

    </span><span class="text-codex-syntax-variable">group</span><span>.</span><span class="text-codex-syntax-attribute">position</span><span>.</span><span class="text-codex-syntax-variable">set</span><span>(</span><span class="text-codex-syntax-literal">0</span><span>, </span><span class="text-codex-syntax-literal">0</span><span>, </span><span class="text-codex-syntax-keyword">-</span><span class="text-codex-syntax-literal">8</span><span>);
