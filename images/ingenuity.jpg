</span><span class="text-codex-syntax-keyword">let </span><span class="text-codex-syntax-variable">yaw </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-literal">0</span><span>;
</span><span class="text-codex-syntax-keyword">let </span><span class="text-codex-syntax-variable">pitch </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-literal">0</span><span>;

</span><span class="text-codex-syntax-keyword">let </span><span class="text-codex-syntax-variable">keys </span><span class="text-codex-syntax-keyword">= </span><span>{};
