                        &lt;</span><span class="text-codex-syntax-name">h3</span><span>&gt;LUNAR ROVING VEHICLE&lt;/</span><span class="text-codex-syntax-name">h3</span><span>&gt;
                        &lt;</span><span class="text-codex-syntax-name">p</span><span>&gt;Discover the electric vehicle used by Apollo astronauts.&lt;/</span><span class="text-codex-syntax-name">p</span><span>&gt;
                        &lt;</span><span class="text-codex-syntax-name">button </span><span class="text-codex-syntax-attribute">class</span><span>=</span><span class="text-codex-syntax-string">"mission-button"</span><span>&gt;EXPLORE MISSION →&lt;/</span><span class="text-codex-syntax-name">button</span><span>&gt;
