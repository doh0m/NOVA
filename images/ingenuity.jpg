        </span><span class="text-codex-syntax-keyword">-</span><span class="text-codex-syntax-variable">Math</span><span>.</span><span class="text-codex-syntax-variable">cos</span><span>(</span><span class="text-codex-syntax-variable">yaw</span><span>)
    );

    </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">right </span><span class="text-codex-syntax-keyword">= new </span><span class="text-codex-syntax-literal">THREE</span><span>.</span><span class="text-codex-syntax-variable">Vector3</span><span>(
        </span><span class="text-codex-syntax-variable">Math</span><span>.</span><span class="text-codex-syntax-variable">cos</span><span>(</span><span class="text-codex-syntax-variable">yaw</span><span>),
