        </span><span class="text-codex-syntax-keyword">-</span><span class="text-codex-syntax-variable">Math</span><span>.</span><span class="text-codex-syntax-variable">sin</span><span>(</span><span class="text-codex-syntax-variable">yaw</span><span>)
