 rel="stylesheet" type="text/css" href="./ingenuity_files/4dcf789e4d97.css"><link rel="stylesheet" type="text/css" href="./ingenuity_files/f813678c40c7.css"><meta http-equiv="origin-trial" content="AlnX2n8fbR+95JAKNy3dCRDeQYJ46G0yr7KdRPQoWh1FvKzmOhwQIFNCWfjj/dQmBLr5nK67TpzCTHvjptvlagkAAABmeyJvcmlnaW4iOiJodHRwczovL2NoYXRncHQuY29tOjQ0MyIsImZlYXR1cmUiOiJXZWJSdGNTY3RwU25hcCIsImV4cGlyeSI6MTgwNjM2NDgwMCwiaXNTdWJkb21haW4iOnRydWV9"><link rel="stylesheet" type="text/css" href="./ingenuity_files/2cadaff72df7.css"><link rel="stylesheet" type="text/css" href="./ingenuity_files/225b7e817ac3.css"><link rel="stylesheet" type="text/css" href="./ingenuity_files/d5f4079e572c.css"><link rel="stylesheet" type="text/css" href="./ingenuity_files/83287e485a90.css"><link rel="stylesheet" type="text/css" href="./ingenuity_files/18ad5d9adcf9.css"><link rel="stylesheet" type="text/css" href="./ingenuity_files/d7d4cf12f802.css"><link rel="stylesheet" type="text/css" href="./ingenuity_files/c56e66b9a94c.css"><link rel="stylesheet" type="text/css" href="./ingenuity_files/9614ca62e6e2.css"><link rel="stylesheet" type="text/css" href="./ingenuity_files/4b94d5ba4831.css"><link rel="stylesheet" type="text/css" href="./ingenuity_files/6a49a5457945.css"><link rel="stylesheet" type="text/css" href="./ingenuity_files/925a69d755b2.css"><link rel="stylesheet" type="text/css" href="./ingenuity_files/8b718a0a727e.css"><link rel="stylesheet" type="text/css" href="./ingenuity_files/5a7fee8bc017.css"><link rel="stylesheet" type="text/css" href="./ingenuity_files/6eb6a6885d1b.css"><link rel="stylesheet" type="text/css" href="./ingenuity_files/65072340dba5.css"><link rel="stylesheet" type="text/css" href="./ingenuity_files/0458dce39c90.css"><link rel="stylesheet" type="text/css" href="./ingenuity_files/a0e9e9cf44d0.css"><link rel="stylesheet" type="text/css" href="https://chatgpt.com/cdn/assets/async/b82568090077.css"><link rel="stylesheet" type="text/css" href="https://chatgpt.com/cdn/assets/async/7334e67ada9c.css"></head><body style="--font-ui-size: 16px; --text-4xl: 36px; --text-3xl: 30px; --text-2xl: 24px; --text-xl: 20px; --text-lg: 18px; --text-base: 16px; --text-sm: 14px; --text-xs: 12px; --text-dynamic-isle-row: 14px; --text-heading-lg: 24px; --text-heading-app: 28px; --text-heading-md: 20px; --text-heading-sm: 18px;"><span data-radix-focus-start="" style="display:contents"></span><script nonce="">
(() => {
  const key = "oai-epic-native-launch";
  let launch = null;
  try { launch = JSON.parse(sessionStorage.getItem(key) || "null"); } catch {}
  function save() {
    try {
      if (launch) sessionStorage.setItem(key, JSON.stringify(launch));
      else sessionStorage.removeItem(key);
    } catch { launch = null; }
  }
  function capture() {
    const fragment = window.location.hash;
    if (!fragment) return;
    window.history.replaceState(window.history.state, "", "/epic/launch");
    const params = new URLSearchParams(fragment.slice(1));
    const snapshot = params.get("snapshot");
    const workspace = params.get("workspace_id");
    launch = Array.from(params).length === (workspace ? 2 : 1) && (!workspace || /^[A-Za-z0-9_-]{1,128}$/.test(workspace)) && snapshot &&
      /^[A-Za-z0-9_-]{80,16384}={0,2}$/.test(snapshot)
      ? { snapshot, workspace, id: crypto.randomUUID(), messageId: null, draftId: null } : null;
    save();
  }
  if (window.location.pathname === "/epic/launch") capture();
  function pending() {
    return launch && !launch.draftId && new URLSearchParams(window.location.search).get("epic_launch") === launch.id
      ? launch.snapshot : null;
  }
  window.__oaiEpicNativeLaunch = {
    get: () => launch?.snapshot ?? null,
    workspace: () => launch?.workspace ?? null,
    destination: () => launch ? "/?surface=work&epic_launch=" + launch.id : "/epic/launch",
    pending,
    ownsMessage: (messageId) => launch?.messageId === messageId,
    metadata: (messageId, draftId) => {
      if (!launch) return;
      if (draftId != null) {
        if (launch.draftId ? launch.draftId !== draftId : !pending()) return;
        launch.draftId = draftId;
      } else if (launch.messageId !== messageId) return;
      const changed = launch.messageId !== messageId;
      launch.messageId = messageId;
      save();
      if (changed) window.dispatchEvent(new Event("oai-epic-launch-changed"));
      return launch ? { epic_launch_snapshot: launch.snapshot } : undefined;
    },
    claimAttachmentNotification: (expected) => {
      if (!launch || launch.snapshot !== expected || launch.attachmentNotified) return false;
      launch.attachmentNotified = true;
      save();
      return true;
    },
    clear: (expected) => {
      if (launch?.snapshot === expected || launch?.messageId === expected) {
        launch = null;
        save();
        window.dispatchEvent(new Event("oai-epic-launch-changed"));
      }
    }
  };
  window.addEventListener("hashchange", () => {
    if (window.location.pathname !== "/epic/launch" || !window.location.hash) return;
    capture();
    window.dispatchEvent(new Event("oai-epic-launch-changed"));
  });
})();
