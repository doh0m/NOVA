</span><span class="text-codex-syntax-keyword">function </span><span class="text-codex-syntax-variable">material</span><span>(</span><span class="text-codex-syntax-variable">color</span><span>, </span><span class="text-codex-syntax-variable">roughness </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-literal">0.8</span><span>, </span><span class="text-codex-syntax-variable">metalness </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-literal">0.1</span><span>) {

    </span><span class="text-codex-syntax-keyword">return new </span><span class="text-codex-syntax-literal">THREE</span><span>.</span><span class="text-codex-syntax-variable">MeshStandardMaterial</span><span>({
        </span><span class="text-codex-syntax-variable">color</span><span>,
        </span><span class="text-codex-syntax-variable">roughness</span><span>,
        </span><span class="text-codex-syntax-variable">metalness</span><span>
</span><span class="text-codex-syntax-variable">    </span><span>});

}


</span><span class="Comment-dh5VVn">/* =========================================================</span><span>
</span><span class="Comment-dh5VVn">   6. TERRAIN GENERATION</span><span>
</span><span class="Comment-dh5VVn">========================================================= */</span><span>

</span><span class="text-codex-syntax-keyword">function </span><span class="text-codex-syntax-variable">createTerrain</span><span>(</span><span class="text-codex-syntax-variable">isMars</span><span>) {

    </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">geometry </span><span class="text-codex-syntax-keyword">= new </span><span class="text-codex-syntax-literal">THREE</span><span>.</span><span class="text-codex-syntax-variable">PlaneGeometry</span><span>(
        </span><span class="text-codex-syntax-literal">1000</span><span>,
        </span><span class="text-codex-syntax-literal">1000</span><span>,
        </span><span class="text-codex-syntax-literal">100</span><span>,
        </span><span class="text-codex-syntax-literal">100</span><span>
</span><span class="text-codex-syntax-literal">    </span><span>);

    </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">positions </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">geometry</span><span>.</span><span class="text-codex-syntax-attribute">attributes</span><span>.</span><span class="text-codex-syntax-attribute">position</span><span>;

    </span><span class="text-codex-syntax-keyword">for </span><span>(</span><span class="text-codex-syntax-keyword">let </span><span class="text-codex-syntax-variable">i </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-literal">0</span><span>; </span><span class="text-codex-syntax-variable">i </span><span class="text-codex-syntax-keyword">&lt; </span><span class="text-codex-syntax-variable">positions</span><span>.</span><span class="text-codex-syntax-attribute">count</span><span>; </span><span class="text-codex-syntax-variable">i</span><span class="text-codex-syntax-keyword">++</span><span>) {

        </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">x </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">positions</span><span>.</span><span class="text-codex-syntax-variable">getX</span><span>(</span><span class="text-codex-syntax-variable">i</span><span>);
        </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">y </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">positions</span><span>.</span><span class="text-codex-syntax-variable">getY</span><span>(</span><span class="text-codex-syntax-variable">i</span><span>);

        </span><span class="text-codex-syntax-keyword">let </span><span class="text-codex-syntax-variable">height </span><span class="text-codex-syntax-keyword">=</span><span>
</span><span class="text-codex-syntax-keyword">            </span><span class="text-codex-syntax-variable">Math</span><span>.</span><span class="text-codex-syntax-variable">sin</span><span>(</span><span class="text-codex-syntax-variable">x </span><span class="text-codex-syntax-keyword">* </span><span class="text-codex-syntax-literal">0.035</span><span>) </span><span class="text-codex-syntax-keyword">* </span><span class="text-codex-syntax-literal">1.2 </span><span class="text-codex-syntax-keyword">+</span><span>
</span><span class="text-codex-syntax-keyword">            </span><span class="text-codex-syntax-variable">Math</span><span>.</span><span class="text-codex-syntax-variable">cos</span><span>(</span><span class="text-codex-syntax-variable">y </span><span class="text-codex-syntax-keyword">* </span><span class="text-codex-syntax-literal">0.04</span><span>) </span><span class="text-codex-syntax-keyword">* </span><span class="text-codex-syntax-literal">1.1 </span><span class="text-codex-syntax-keyword">+</span><span>
</span><span class="text-codex-syntax-keyword">            </span><span class="text-codex-syntax-variable">Math</span><span>.</span><span class="text-codex-syntax-variable">sin</span><span>((</span><span class="text-codex-syntax-variable">x </span><span class="text-codex-syntax-keyword">+ </span><span class="text-codex-syntax-variable">y</span><span>) </span><span class="text-codex-syntax-keyword">* </span><span class="text-codex-syntax-literal">0.025</span><span>) </span><span class="text-codex-syntax-keyword">* </span><span class="text-codex-syntax-literal">0.8</span><span>;

        </span><span class="text-codex-syntax-keyword">if </span><span>(</span><span class="text-codex-syntax-variable">isMars</span><span>) {
            </span><span class="text-codex-syntax-variable">height </span><span class="text-codex-syntax-keyword">+= </span><span class="text-codex-syntax-variable">Math</span><span>.</span><span class="text-codex-syntax-variable">sin</span><span>(</span><span class="text-codex-syntax-variable">x </span><span class="text-codex-syntax-keyword">* </span><span class="text-codex-syntax-literal">0.015</span><span>) </span><span class="text-codex-syntax-keyword">* </span><span class="text-codex-syntax-literal">3</span><span>;
        }

        </span><span class="text-codex-syntax-variable">positions</span><span>.</span><span class="text-codex-syntax-variable">setZ</span><span>(</span><span class="text-codex-syntax-variable">i</span><span>, </span><span class="text-codex-syntax-variable">height</span><span>);
    }

    </span><span class="text-codex-syntax-variable">geometry</span><span>.</span><span class="text-codex-syntax-variable">computeVertexNormals</span><span>();

    </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">groundMaterial </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">material</span><span>(
        </span><span class="text-codex-syntax-variable">isMars </span><span class="text-codex-syntax-keyword">? </span><span class="text-codex-syntax-literal">0x9b5238 </span><span>: </span><span class="text-codex-syntax-literal">0x777777</span><span>,
        </span><span class="text-codex-syntax-literal">1</span><span>,
        </span><span class="text-codex-syntax-literal">0</span><span>
</span><span class="text-codex-syntax-literal">    </span><span>);

    </span><span class="text-codex-syntax-variable">terrain </span><span class="text-codex-syntax-keyword">= new </span><span class="text-codex-syntax-literal">THREE</span><span>.</span><span class="text-codex-syntax-variable">Mesh</span><span>(</span><span class="text-codex-syntax-variable">geometry</span><span>, </span><span class="text-codex-syntax-variable">groundMaterial</span><span>);

    </span><span class="text-codex-syntax-variable">terrain</span><span>.</span><span class="text-codex-syntax-attribute">rotation</span><span>.</span><span class="text-codex-syntax-attribute">x </span><span class="text-codex-syntax-keyword">= -</span><span class="text-codex-syntax-variable">Math</span><span>.</span><span class="text-codex-syntax-attribute">PI </span><span class="text-codex-syntax-keyword">/ </span><span class="text-codex-syntax-literal">2</span><span>;
    </span><span class="text-codex-syntax-variable">terrain</span><span>.</span><span class="text-codex-syntax-attribute">position</span><span>.</span><span class="text-codex-syntax-attribute">y </span><span class="text-codex-syntax-keyword">= -</span><span class="text-codex-syntax-literal">1</span><span>;

    </span><span class="text-codex-syntax-variable">scene</span><span>.</span><span class="text-codex-syntax-variable">add</span><span>(</span><span class="text-codex-syntax-variable">terrain</span><span>);

}


</span><span class="Comment-dh5VVn">/* =========================================================</span><span>
</span><span class="Comment-dh5VVn">   7. ROCKS AND ENVIRONMENT</span><span>
</span><span class="Comment-dh5VVn">========================================================= */</span><span>

</span><span class="text-codex-syntax-keyword">function </span><span class="text-codex-syntax-variable">addRocks</span><span>(</span><span class="text-codex-syntax-variable">isMars</span><span>, </span><span class="text-codex-syntax-variable">amount </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-literal">100</span><span>) {

    </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">rockMaterial </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">material</span><span>(
        </span><span class="text-codex-syntax-variable">isMars </span><span class="text-codex-syntax-keyword">? </span><span class="text-codex-syntax-literal">0x754332 </span><span>: </span><span class="text-codex-syntax-literal">0x555555</span><span>
</span><span class="text-codex-syntax-literal">    </span><span>);

    </span><span class="text-codex-syntax-keyword">for </span><span>(</span><span class="text-codex-syntax-keyword">let </span><span class="text-codex-syntax-variable">i </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-literal">0</span><span>; </span><span class="text-codex-syntax-variable">i </span><span class="text-codex-syntax-keyword">&lt; </span><span class="text-codex-syntax-variable">amount</span><span>; </span><span class="text-codex-syntax-variable">i</span><span class="text-codex-syntax-keyword">++</span><span>) {

        </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">geometry </span><span class="text-codex-syntax-keyword">= new </span><span class="text-codex-syntax-literal">THREE</span><span>.</span><span class="text-codex-syntax-variable">DodecahedronGeometry</span><span>(
            </span><span class="text-codex-syntax-variable">Math</span><span>.</span><span class="text-codex-syntax-variable">random</span><span>() </span><span class="text-codex-syntax-keyword">* </span><span class="text-codex-syntax-literal">1.8 </span><span class="text-codex-syntax-keyword">+ </span><span class="text-codex-syntax-literal">0.5</span><span>,
            </span><span class="text-codex-syntax-literal">0</span><span>
</span><span class="text-codex-syntax-literal">        </span><span>);

        </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">rock </span><span class="text-codex-syntax-keyword">= new </span><span class="text-codex-syntax-literal">THREE</span><span>.</span><span class="text-codex-syntax-variable">Mesh</span><span>(
            </span><span class="text-codex-syntax-variable">geometry</span><span>,
            </span><span class="text-codex-syntax-variable">rockMaterial</span><span>
</span><span class="text-codex-syntax-variable">        </span><span>);

        </span><span class="text-codex-syntax-variable">rock</span><span>.</span><span class="text-codex-syntax-attribute">position</span><span>.</span><span class="text-codex-syntax-variable">set</span><span>(
            (</span><span class="text-codex-syntax-variable">Math</span><span>.</span><span class="text-codex-syntax-variable">random</span><span>() </span><span class="text-codex-syntax-keyword">- </span><span class="text-codex-syntax-literal">0.5</span><span>) </span><span class="text-codex-syntax-keyword">* </span><span class="text-codex-syntax-literal">180</span><span>,
            </span><span class="text-codex-syntax-keyword">-</span><span class="text-codex-syntax-literal">0.3</span><span>,
            (</span><span class="text-codex-syntax-variable">Math</span><span>.</span><span class="text-codex-syntax-variable">random</span><span>() </span><span class="text-codex-syntax-keyword">- </span><span class="text-codex-syntax-literal">0.5</span><span>) </span><span class="text-codex-syntax-keyword">* </span><span class="text-codex-syntax-literal">180</span><span>
</span><span class="text-codex-syntax-literal">        </span><span>);

        </span><span class="text-codex-syntax-variable">rock</span><span>.</span><span class="text-codex-syntax-attribute">rotation</span><span>.</span><span class="text-codex-syntax-variable">set</span><span>(
            </span><span class="text-codex-syntax-variable">Math</span><span>.</span><span class="text-codex-syntax-variable">random</span><span>(),
            </span><span class="text-codex-syntax-variable">Math</span><span>.</span><span class="text-codex-syntax-variable">random</span><span>(),
            </span><span class="text-codex-syntax-variable">Math</span><span>.</span><span class="text-codex-syntax-variable">random</span><span>()
        );

        </span><span class="text-codex-syntax-variable">scene</span><span>.</span><span class="text-codex-syntax-variable">add</span><span>(</span><span class="text-codex-syntax-variable">rock</span><span>);
    }

}


</span><span class="Comment-dh5VVn">/* =========================================================</span><span>
</span><span class="Comment-dh5VVn">   8. STARS</span><span>
</span><span class="Comment-dh5VVn">========================================================= */</span><span>

</span><span class="text-codex-syntax-keyword">function </span><span class="text-codex-syntax-variable">addStars</span><span>() {

    </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">geometry </span><span class="text-codex-syntax-keyword">= new </span><span class="text-codex-syntax-literal">THREE</span><span>.</span><span class="text-codex-syntax-variable">BufferGeometry</span><span>();
    </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">positions </span><span class="text-codex-syntax-keyword">= </span><span>[];

    </span><span class="text-codex-syntax-keyword">for </span><span>(</span><span class="text-codex-syntax-keyword">let </span><span class="text-codex-syntax-variable">i </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-literal">0</span><span>; </span><span class="text-codex-syntax-variable">i </span><span class="text-codex-syntax-keyword">&lt; </span><span class="text-codex-syntax-literal">2500</span><span>; </span><span class="text-codex-syntax-variable">i</span><span class="text-codex-syntax-keyword">++</span><span>) {

        </span><span class="text-codex-syntax-variable">positions</span><span>.</span><span class="text-codex-syntax-variable">push</span><span>(
            (</span><span class="text-codex-syntax-variable">Math</span><span>.</span><span class="text-codex-syntax-variable">random</span><span>() </span><span class="text-codex-syntax-keyword">- </span><span class="text-codex-syntax-literal">0.5</span><span>) </span><span class="text-codex-syntax-keyword">* </span><span class="text-codex-syntax-literal">800</span><span>,
            </span><span class="text-codex-syntax-variable">Math</span><span>.</span><span class="text-codex-syntax-variable">random</span><span>() </span><span class="text-codex-syntax-keyword">* </span><span class="text-codex-syntax-literal">350 </span><span class="text-codex-syntax-keyword">+ </span><span class="text-codex-syntax-literal">20</span><span>,
            (</span><span class="text-codex-syntax-variable">Math</span><span>.</span><span class="text-codex-syntax-variable">random</span><span>() </span><span class="text-codex-syntax-keyword">- </span><span class="text-codex-syntax-literal">0.5</span><span>) </span><span class="text-codex-syntax-keyword">* </span><span class="text-codex-syntax-literal">800</span><span>
</span><span class="text-codex-syntax-literal">        </span><span>);

    }

    </span><span class="text-codex-syntax-variable">geometry</span><span>.</span><span class="text-codex-syntax-variable">setAttribute</span><span>(
        </span><span class="text-codex-syntax-string">"position"</span><span>,
        </span><span class="text-codex-syntax-keyword">new </span><span class="text-codex-syntax-literal">THREE</span><span>.</span><span class="text-codex-syntax-variable">Float32BufferAttribute</span><span>(</span><span class="text-codex-syntax-variable">positions</span><span>, </span><span class="text-codex-syntax-literal">3</span><span>)
    );

    </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">stars </span><span class="text-codex-syntax-keyword">= new </span><span class="text-codex-syntax-literal">THREE</span><span>.</span><span class="text-codex-syntax-variable">Points</span><span>(
        </span><span class="text-codex-syntax-variable">geometry</span><span>,
        </span><span class="text-codex-syntax-keyword">new </span><span class="text-codex-syntax-literal">THREE</span><span>.</span><span class="text-codex-syntax-variable">PointsMaterial</span><span>({
            </span><span class="text-codex-syntax-attribute">color</span><span>: </span><span class="text-codex-syntax-literal">0xffffff</span><span>,
            </span><span class="text-codex-syntax-attribute">size</span><span>: </span><span class="text-codex-syntax-literal">0.8</span><span>
</span><span class="text-codex-syntax-literal">        </span><span>})
    );

    </span><span class="text-codex-syntax-variable">scene</span><span>.</span><span class="text-codex-syntax-variable">add</span><span>(</span><span class="text-codex-syntax-variable">stars</span><span>);

}


</span><span class="Comment-dh5VVn">/* =========================================================</span><span>
</span><span class="Comment-dh5VVn">   9. BASIC 3D OBJECTS</span><span>
