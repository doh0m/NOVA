        &lt;</span><span class="text-codex-syntax-name">div </span><span class="text-codex-syntax-attribute">id</span><span>=</span><span class="text-codex-syntax-string">"interaction-prompt"</span><span>&gt;
            PRESS &lt;</span><span class="text-codex-syntax-name">kbd</span><span>&gt;E&lt;/</span><span class="text-codex-syntax-name">kbd</span><span>&gt; TO INVESTIGATE
        &lt;/</span><span class="text-codex-syntax-name">div</span><span>&gt;

        &lt;</span><span class="text-codex-syntax-name">div </span><span class="text-codex-syntax-attribute">id</span><span>=</span><span class="text-codex-syntax-string">"discovery-message" </span><span class="text-codex-syntax-attribute">class</span><span>=</span><span class="text-codex-syntax-string">"discovery-message"</span><span>&gt;
