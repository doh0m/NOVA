    </span><span class="text-codex-syntax-attribute">text-align</span><span>: </span><span class="text-codex-syntax-literal">center</span><span>;
    </span><span class="text-codex-syntax-attribute">padding</span><span>: </span><span class="text-codex-syntax-literal">30px</span><span>;
    </span><span class="text-codex-syntax-attribute">background</span><span>:
        </span><span class="text-codex-syntax-variable">radial-gradient</span><span>(</span><span class="text-codex-syntax-literal">circle at center</span><span>, </span><span class="text-codex-syntax-variable">rgba</span><span>(</span><span class="text-codex-syntax-literal">30</span><span>,</span><span class="text-codex-syntax-literal">95</span><span>,</span><span class="text-codex-syntax-literal">135</span><span>,</span><span class="text-codex-syntax-literal">.18</span><span>), </span><span class="text-codex-syntax-literal">transparent 55%</span><span>);
}

</span><span class="text-codex-syntax-attribute">.complete-screen.active </span><span>{
    </span><span class="text-codex-syntax-attribute">display</span><span>: </span><span class="text-codex-syntax-literal">flex</span><span>;
}

</span><span class="text-codex-syntax-attribute">.complete-content </span><span>{
    </span><span class="text-codex-syntax-attribute">width</span><span>: </span><span class="text-codex-syntax-literal">100%</span><span>;
    </span><span class="text-codex-syntax-attribute">max-width</span><span>: </span><span class="text-codex-syntax-literal">700px</span><span>;
}

</span><span class="text-codex-syntax-attribute">.complete-symbol </span><span>{
    </span><span class="text-codex-syntax-attribute">width</span><span>: </span><span class="text-codex-syntax-literal">75px</span><span>;
    </span><span class="text-codex-syntax-attribute">height</span><span>: </span><span class="text-codex-syntax-literal">75px</span><span>;
    </span><span class="text-codex-syntax-attribute">margin</span><span>: </span><span class="text-codex-syntax-literal">30px auto</span><span>;
    </span><span class="text-codex-syntax-attribute">display</span><span>: </span><span class="text-codex-syntax-literal">grid</span><span>;
    </span><span class="text-codex-syntax-attribute">place-items</span><span>: </span><span class="text-codex-syntax-literal">center</span><span>;
    </span><span class="text-codex-syntax-attribute">border</span><span>: </span><span class="text-codex-syntax-literal">1px solid </span><span class="text-codex-syntax-variable">var</span><span>(</span><span class="text-codex-syntax-variable">--blue</span><span>);
    </span><span class="text-codex-syntax-attribute">border-radius</span><span>: </span><span class="text-codex-syntax-literal">50%</span><span>;
    </span><span class="text-codex-syntax-attribute">color</span><span>: </span><span class="text-codex-syntax-variable">var</span><span>(</span><span class="text-codex-syntax-variable">--blue</span><span>);
    </span><span class="text-codex-syntax-attribute">font-size</span><span>: </span><span class="text-codex-syntax-literal">35px</span><span>;
}

</span><span class="text-codex-syntax-attribute">.complete-content </span><span class="text-codex-syntax-name">h1 </span><span>{
    </span><span class="text-codex-syntax-attribute">font-family</span><span>: </span><span class="text-codex-syntax-string">'Orbitron'</span><span>, </span><span class="text-codex-syntax-literal">sans-serif</span><span>;
    </span><span class="text-codex-syntax-attribute">font-size</span><span>: </span><span class="text-codex-syntax-variable">clamp</span><span>(</span><span class="text-codex-syntax-literal">40px</span><span>, </span><span class="text-codex-syntax-literal">7vw</span><span>, </span><span class="text-codex-syntax-literal">65px</span><span>);
    </span><span class="text-codex-syntax-attribute">line-height</span><span>: </span><span class="text-codex-syntax-literal">1.1</span><span>;
}

</span><span class="text-codex-syntax-attribute">.complete-content </span><span class="text-codex-syntax-name">h1 span </span><span>{
    </span><span class="text-codex-syntax-attribute">color</span><span>: </span><span class="text-codex-syntax-variable">var</span><span>(</span><span class="text-codex-syntax-variable">--blue</span><span>);
}

</span><span class="text-codex-syntax-attribute">.complete-content </span><span class="text-codex-syntax-keyword">&gt; </span><span class="text-codex-syntax-name">p</span><span class="text-codex-syntax-attribute">:not</span><span>(</span><span class="text-codex-syntax-attribute">.eyebrow</span><span>) {
    </span><span class="text-codex-syntax-attribute">margin-top</span><span>: </span><span class="text-codex-syntax-literal">20px</span><span>;
    </span><span class="text-codex-syntax-attribute">color</span><span>: </span><span class="text-codex-syntax-variable">var</span><span>(</span><span class="text-codex-syntax-variable">--muted</span><span>);
    </span><span class="text-codex-syntax-attribute">font-size</span><span>: </span><span class="text-codex-syntax-literal">13px</span><span>;
    </span><span class="text-codex-syntax-attribute">line-height</span><span>: </span><span class="text-codex-syntax-literal">1.7</span><span>;
}

</span><span class="text-codex-syntax-attribute">.complete-stats </span><span>{
    </span><span class="text-codex-syntax-attribute">display</span><span>: </span><span class="text-codex-syntax-literal">grid</span><span>;
    </span><span class="text-codex-syntax-attribute">grid-template-columns</span><span>: </span><span class="text-codex-syntax-variable">repeat</span><span>(</span><span class="text-codex-syntax-literal">3</span><span>, </span><span class="text-codex-syntax-literal">1fr</span><span>);
    </span><span class="text-codex-syntax-attribute">gap</span><span>: </span><span class="text-codex-syntax-literal">12px</span><span>;
    </span><span class="text-codex-syntax-attribute">margin</span><span>: </span><span class="text-codex-syntax-literal">35px 0</span><span>;
    </span><span class="text-codex-syntax-attribute">text-align</span><span>: </span><span class="text-codex-syntax-literal">left</span><span>;
}

</span><span class="Comment-dh5VVn">/* RESPONSIVE */</span><span>

</span><span class="text-codex-syntax-keyword">@media </span><span>(</span><span class="text-codex-syntax-attribute">max-width</span><span>: </span><span class="text-codex-syntax-literal">1000px</span><span>) {
    </span><span class="text-codex-syntax-attribute">.mission-grid </span><span>{
        </span><span class="text-codex-syntax-attribute">grid-template-columns</span><span>: </span><span class="text-codex-syntax-variable">repeat</span><span>(</span><span class="text-codex-syntax-literal">2</span><span>, </span><span class="text-codex-syntax-literal">1fr</span><span>);
    }

    </span><span class="text-codex-syntax-attribute">.briefing-container </span><span>{
        </span><span class="text-codex-syntax-attribute">grid-template-columns</span><span>: </span><span class="text-codex-syntax-literal">1fr</span><span>;
    }

    </span><span class="text-codex-syntax-attribute">.briefing-image </span><span>{
        </span><span class="text-codex-syntax-attribute">height</span><span>: </span><span class="text-codex-syntax-literal">350px</span><span>;
    }
}

</span><span class="text-codex-syntax-keyword">@media </span><span>(</span><span class="text-codex-syntax-attribute">max-width</span><span>: </span><span class="text-codex-syntax-literal">600px</span><span>) {
    </span><span class="text-codex-syntax-attribute">.topbar</span><span>,
    </span><span class="text-codex-syntax-attribute">.subpage-header </span><span>{
        </span><span class="text-codex-syntax-attribute">padding</span><span>: </span><span class="text-codex-syntax-literal">0 20px</span><span>;
    }

    </span><span class="text-codex-syntax-attribute">.topbar-label </span><span>{
        </span><span class="text-codex-syntax-attribute">display</span><span>: </span><span class="text-codex-syntax-literal">none</span><span>;
    }

    </span><span class="text-codex-syntax-attribute">.hero </span><span>{
        </span><span class="text-codex-syntax-attribute">padding</span><span>: </span><span class="text-codex-syntax-literal">80px 25px</span><span>;
    }

    </span><span class="text-codex-syntax-attribute">.missions-section </span><span>{
        </span><span class="text-codex-syntax-attribute">padding</span><span>: </span><span class="text-codex-syntax-literal">50px 20px</span><span>;
    }

    </span><span class="text-codex-syntax-attribute">.mission-grid </span><span>{
        </span><span class="text-codex-syntax-attribute">grid-template-columns</span><span>: </span><span class="text-codex-syntax-literal">1fr</span><span>;
    }

    </span><span class="text-codex-syntax-attribute">.section-heading </span><span>{
        </span><span class="text-codex-syntax-attribute">align-items</span><span>: </span><span class="text-codex-syntax-literal">start</span><span>;
        </span><span class="text-codex-syntax-attribute">flex-direction</span><span>: </span><span class="text-codex-syntax-literal">column</span><span>;
        </span><span class="text-codex-syntax-attribute">gap</span><span>: </span><span class="text-codex-syntax-literal">15px</span><span>;
    }

    </span><span class="text-codex-syntax-attribute">.briefing-container </span><span>{
        </span><span class="text-codex-syntax-attribute">width</span><span>: </span><span class="text-codex-syntax-literal">90%</span><span>;
        </span><span class="text-codex-syntax-attribute">margin</span><span>: </span><span class="text-codex-syntax-literal">35px auto</span><span>;
    }

    </span><span class="text-codex-syntax-attribute">.briefing-content </span><span class="text-codex-syntax-name">h1 </span><span>{
        </span><span class="text-codex-syntax-attribute">font-size</span><span>: </span><span class="text-codex-syntax-literal">25px</span><span>;
    }

    </span><span class="text-codex-syntax-attribute">.briefing-data </span><span>{
        </span><span class="text-codex-syntax-attribute">grid-template-columns</span><span>: </span><span class="text-codex-syntax-literal">1fr</span><span>;
    }

    </span><span class="text-codex-syntax-attribute">.tutorial-box </span><span>{
        </span><span class="text-codex-syntax-attribute">padding</span><span>: </span><span class="text-codex-syntax-literal">25px</span><span>;
    }

    </span><span class="text-codex-syntax-attribute">.controls-grid </span><span>{
        </span><span class="text-codex-syntax-attribute">grid-template-columns</span><span>: </span><span class="text-codex-syntax-literal">1fr</span><span>;
    }

    </span><span class="text-codex-syntax-attribute">.game-header </span><span>{
        </span><span class="text-codex-syntax-attribute">padding</span><span>: </span><span class="text-codex-syntax-literal">0 15px</span><span>;
    }

    </span><span class="text-codex-syntax-attribute">.game-hud </span><span>{
        </span><span class="text-codex-syntax-attribute">top</span><span>: </span><span class="text-codex-syntax-literal">85px</span><span>;
        </span><span class="text-codex-syntax-attribute">left</span><span>: </span><span class="text-codex-syntax-literal">10px</span><span>;
        </span><span class="text-codex-syntax-attribute">flex-direction</span><span>: </span><span class="text-codex-syntax-literal">column</span><span>;
    }

    </span><span class="text-codex-syntax-attribute">.hud-panel </span><span>{
        </span><span class="text-codex-syntax-attribute">min-width</span><span>: </span><span class="text-codex-syntax-literal">150px</span><span>;
        </span><span class="text-codex-syntax-attribute">padding</span><span>: </span><span class="text-codex-syntax-literal">10px</span><span>;
    }

    </span><span class="text-codex-syntax-attribute">.location-panel </span><span>{
        </span><span class="text-codex-syntax-attribute">display</span><span>: </span><span class="text-codex-syntax-literal">none</span><span>;
    }

    </span><span class="text-codex-syntax-attribute">.minimap </span><span>{
        </span><span class="text-codex-syntax-attribute">right</span><span>: </span><span class="text-codex-syntax-literal">10px</span><span>;
        </span><span class="text-codex-syntax-attribute">bottom</span><span>: </span><span class="text-codex-syntax-literal">55px</span><span>;
        </span><span class="text-codex-syntax-attribute">transform</span><span>: </span><span class="text-codex-syntax-variable">scale</span><span>(</span><span class="text-codex-syntax-literal">.75</span><span>);
        </span><span class="text-codex-syntax-attribute">transform-origin</span><span>: </span><span class="text-codex-syntax-literal">bottom right</span><span>;
    }

    </span><span class="text-codex-syntax-attribute">.game-controls </span><span>{
        </span><span class="text-codex-syntax-attribute">left</span><span>: </span><span class="text-codex-syntax-literal">10px</span><span>;
        </span><span class="text-codex-syntax-attribute">font-size</span><span>: </span><span class="text-codex-syntax-literal">7px</span><span>;
    }

    </span><span class="text-codex-syntax-attribute">.complete-stats </span><span>{
        </span><span class="text-codex-syntax-attribute">grid-template-columns</span><span>: </span><span class="text-codex-syntax-literal">1fr</span><span>;
    }

    </span><span class="text-codex-syntax-attribute">.main-footer </span><span>{
        </span><span class="text-codex-syntax-attribute">flex-direction</span><span>: </span><span class="text-codex-syntax-literal">column</span><span>;
        </span><span class="text-codex-syntax-attribute">gap</span><span>: </span><span class="text-codex-syntax-literal">12px</span><span>;
    }
}</span></code></pre></div></div></div><button class="group/scroll-to-bottom cursor-interaction absolute z-30 flex h-8 translate-x-1/2 items-center justify-center rounded-full text-secondary transition-[width,opacity] duration-120 ease-out motion-reduce:transition-none end-1/2 print:hidden w-8 pointer-events-none opacity-0 bottom-4" aria-hidden="true" aria-label="Ir al final" tabindex="-1" type="button"><span class="pointer-events-none flex h-full shrink-0 items-center justify-center rounded-full border border-default bg-surface bg-clip-padding shadow-md transition-[width] duration-120 ease-out motion-reduce:transition-none w-8"><svg aria-hidden="true" class="Icon-X4VkKC text-default" focusable="false" height="20" viewBox="0 0 20 20" width="20" xmlns="http://www.w3.org/2000/svg"><use href="/cdn/assets/icons-65c0f11497ac4847.svg#codex-icon-arrow-down-lg-light-20" fill="currentColor"></use></svg></span></button></div></div></div></div><div class="Divider-aIXBUs" data-d-component="divider" style="--divider-color: var(--color-border); --divider-size: 1px;"></div><h2 class="TextBase-kDAqPL Title-ij922C" data-d-text-flow="" data-d-component="title" data-d-size="lg" data-d-weight="semibold"><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(237, 237, 237);"><strong class="Emphasis-BHzYtQ">3. </strong></span><code class="Code-LNMR8q" data-d-component="code"><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(237, 237, 237);">script.js</span></code></h2><p class="TextBase-kDAqPL Text-dOmvsS" data-d-text-flow="" data-d-component="text"><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(237, 237, 237);">Borrá el contenido anterior de </span><code class="Code-LNMR8q" data-d-component="code"><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(237, 237, 237);">script.js</span></code><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(237, 237, 237);"> y pegá esto:</span></p><div data-client-defined-widget="code_block"><div data-chatgpt-copy-code="/* =========================================================
   NOVA SPACE EXPLORATION
   MAIN INTERACTIVE SYSTEM
   THREE.JS r128
========================================================= */


/* =========================================================
   1. MISSION DATABASE
========================================================= */

const missions = {

    apollo: {
        number: &quot;001&quot;,
        name: &quot;APOLLO LUNAR MODULE&quot;,
        location: &quot;THE MOON&quot;,
        destination: &quot;SEA OF TRANQUILITY&quot;,
        type: &quot;LUNAR LANDING SYSTEM&quot;,
        year: &quot;1969&quot;,
        image: &quot;images/apollo-module.jpg&quot;,

        description:
            &quot;The Apollo Lunar Module was the spacecraft designed to transport astronauts from lunar orbit to the Moon's surface. Its descent stage remained on the Moon after the astronauts returned to orbit.&quot;,

        objective:
            &quot;Investigate the lunar module and identify the main components of the historic landing system.&quot;,

        discoveries: [
            {
                name: &quot;DESCENT STAGE&quot;,
                description:
                    &quot;The descent stage supported the lunar module during landing. It remained on the Moon and served as the launch platform for the ascent stage.&quot;
            },
            {
                name: &quot;LANDING LEGS&quot;,
                description:
                    &quot;The landing legs absorbed the impact of touchdown and supported the lunar module on the lunar surface.&quot;
            },
            {
                name: &quot;LUNAR SURFACE&quot;,
                description:
                    &quot;The Sea of Tranquility was the landing region of Apollo 11 on July 20, 1969.&quot;
            }
        ]
    },

    lrv: {
        number: &quot;002&quot;,
        name: &quot;LUNAR ROVING VEHICLE&quot;,
        location: &quot;THE MOON&quot;,
        destination: &quot;APOLLO EXPLORATION REGION&quot;,
        type: &quot;CREWED ELECTRIC VEHICLE&quot;,
        year: &quot;1971–1972&quot;,
        image: &quot;images/lunar-rover.jpg&quot;,

        description:
            &quot;The Lunar Roving Vehicle was an electric vehicle used by astronauts during Apollo 15, Apollo 16 and Apollo 17. It expanded the distance astronauts could explore on the lunar surface.&quot;,

        objective:
            &quot;Explore the lunar rover and investigate its mobility system, scientific equipment and structure.&quot;,

        discoveries: [
            {
                name: &quot;ROVER WHEELS&quot;,
                description:
                    &quot;The LRV used four specially designed wheels to travel across the Moon's rough surface.&quot;
            },
            {
                name: &quot;NAVIGATION SYSTEM&quot;,
                description:
                    &quot;The rover included navigation equipment that helped astronauts monitor their position and direction.&quot;
            },
            {
                name: &quot;SCIENTIFIC EQUIPMENT&quot;,
                description:
                    &quot;The rover carried equipment and tools that helped astronauts collect geological samples and investigate the Moon.&quot;
            }
        ]
    },

    sojourner: {
        number: &quot;003&quot;,
        name: &quot;SOJOURNER ROVER&quot;,
        location: &quot;MARS&quot;,
        destination: &quot;AREAS VALLIS&quot;,
        type: &quot;ROBOTIC ROVER&quot;,
        year: &quot;1997&quot;,
        image: &quot;images/sojourner.jpg&quot;,

        description:
            &quot;Sojourner was the first successful robotic rover to operate on Mars. It arrived with the Mars Pathfinder lander in 1997 and studied nearby rocks and soil.&quot;,

        objective:
            &quot;Investigate the Martian environment and discover how the first rover studied the planet.&quot;,

        discoveries: [
            {
                name: &quot;ROBOTIC WHEELS&quot;,
                description:
                    &quot;Sojourner used six wheels to move across the Martian terrain and approach rocks for scientific investigation.&quot;
            },
            {
                name: &quot;ALPHA PROTON X-RAY SPECTROMETER&quot;,
                description:
                    &quot;This instrument helped scientists analyze the chemical composition of Martian rocks and soil.&quot;
            },
            {
                name: &quot;MARS PATHFINDER&quot;,
                description:
                    &quot;The Pathfinder lander delivered Sojourner to Mars and served as its communication link with Earth.&quot;
            }
        ]
    },

    ingenuity: {
        number: &quot;004&quot;,
        name: &quot;INGENUITY HELICOPTER&quot;,
        location: &quot;MARS&quot;,
        destination: &quot;JEZERO CRATER&quot;,
        type: &quot;ROBOTIC HELICOPTER&quot;,
        year: &quot;2021–2024&quot;,
        image: &quot;images/ingenuity.jpg&quot;,

        description:
            &quot;NASA's Ingenuity helicopter became the first aircraft to achieve powered, controlled flight on another planet. It operated on Mars alongside the Perseverance rover.&quot;,

        objective:
            &quot;Investigate the helicopter's design, flight system and exploration role on Mars.&quot;,

        discoveries: [
            {
                name: &quot;ROTOR SYSTEM&quot;,
                description:
                    &quot;Ingenuity used two counter-rotating rotor blades to generate lift in the extremely thin Martian atmosphere.&quot;
            },
            {
                name: &quot;SOLAR PANEL&quot;,
                description:
                    &quot;A solar panel collected energy to recharge the helicopter's batteries and support its operations.&quot;
            },
            {
                name: &quot;FLIGHT LANDING AREA&quot;,
                description:
                    &quot;Ingenuity demonstrated that powered flight was possible on Mars. Its mission ended in January 2024 after rotor damage.&quot;
            }
        ]
    }

};


/* =========================================================
   2. SCREEN NAVIGATION
========================================================= */

const screens = document.querySelectorAll(&quot;.screen&quot;);

function showScreen(id) {
    screens.forEach(screen =&gt; {
        screen.classList.remove(&quot;active&quot;);
    });

    document.getElementById(id).classList.add(&quot;active&quot;);
}

let selectedMission = null;

document.querySelectorAll(&quot;.mission-card&quot;).forEach(card =&gt; {
    card.addEventListener(&quot;click&quot;, () =&gt; {
        openMission(card.dataset.mission);
    });
});

document.getElementById(&quot;start-button&quot;).addEventListener(&quot;click&quot;, () =&gt; {
    document.querySelector(&quot;.missions-section&quot;).scrollIntoView({
        behavior: &quot;smooth&quot;
    });
});

document.getElementById(&quot;back-home&quot;).addEventListener(&quot;click&quot;, () =&gt; {
    showScreen(&quot;home-screen&quot;);
});

function openMission(id) {

    selectedMission = missions[id];

    if (!selectedMission) return;

    document.getElementById(&quot;briefing-image&quot;).src =
        selectedMission.image;

    document.getElementById(&quot;briefing-number&quot;).textContent =
        &quot;MISSION &quot; + selectedMission.number;

    document.getElementById(&quot;briefing-location&quot;).textContent =
        selectedMission.location;

    document.getElementById(&quot;briefing-title&quot;).textContent =
        selectedMission.name;

    document.getElementById(&quot;briefing-description&quot;).textContent =
        selectedMission.description;

    document.getElementById(&quot;briefing-destination&quot;).textContent =
        selectedMission.destination;

    document.getElementById(&quot;briefing-type&quot;).textContent =
        selectedMission.type;

    document.getElementById(&quot;briefing-year&quot;).textContent =
        selectedMission.year;

    document.getElementById(&quot;briefing-objective&quot;).textContent =
        selectedMission.objective;

    showScreen(&quot;briefing-screen&quot;);
}


/* =========================================================
   3. TUTORIAL
========================================================= */

document.getElementById(&quot;launch-button&quot;).addEventListener(&quot;click&quot;, () =&gt; {
    showScreen(&quot;tutorial-screen&quot;);
});

document.getElementById(&quot;tutorial-start&quot;).addEventListener(&quot;click&quot;, () =&gt; {

    showScreen(&quot;exploration-screen&quot;);

    startExploration();
});


/* =========================================================
   4. THREE.JS VARIABLES
========================================================= */

let scene;
let camera;
let renderer;
let clock;

let terrain;
let playerPosition = new THREE.Vector3(0, 2, 12);

let yaw = 0;
let pitch = 0;

let keys = {};
let discoveries = [];
let foundDiscoveries = [];

let activeDiscovery = null;
let isExploring = false;
let isPaused = false;

let animationFrame;


/* =========================================================
   5. MATERIALS
========================================================= */

function material(color, roughness = 0.8, metalness = 0.1) {

    return new THREE.MeshStandardMaterial({
        color,
        roughness,
        metalness
    });

}


/* =========================================================
   6. TERRAIN GENERATION
========================================================= */

function createTerrain(isMars) {

    const geometry = new THREE.PlaneGeometry(
        1000,
        1000,
        100,
        100
    );

    const positions = geometry.attributes.position;

    for (let i = 0; i &lt; positions.count; i++) {

        const x = positions.getX(i);
        const y = positions.getY(i);

        let height =
            Math.sin(x * 0.035) * 1.2 +
            Math.cos(y * 0.04) * 1.1 +
            Math.sin((x + y) * 0.025) * 0.8;

        if (isMars) {
            height += Math.sin(x * 0.015) * 3;
        }

        positions.setZ(i, height);
    }

    geometry.computeVertexNormals();

    const groundMaterial = material(
        isMars ? 0x9b5238 : 0x777777,
        1,
        0
    );

    terrain = new THREE.Mesh(geometry, groundMaterial);

    terrain.rotation.x = -Math.PI / 2;
    terrain.position.y = -1;

    scene.add(terrain);

}


/* =========================================================
   7. ROCKS AND ENVIRONMENT
========================================================= */

function addRocks(isMars, amount = 100) {

    const rockMaterial = material(
        isMars ? 0x754332 : 0x555555
    );

    for (let i = 0; i &lt; amount; i++) {

        const geometry = new THREE.DodecahedronGeometry(
            Math.random() * 1.8 + 0.5,
            0
        );

        const rock = new THREE.Mesh(
            geometry,
            rockMaterial
        );

        rock.position.set(
            (Math.random() - 0.5) * 180,
            -0.3,
            (Math.random() - 0.5) * 180
        );

        rock.rotation.set(
            Math.random(),
            Math.random(),
            Math.random()
        );

        scene.add(rock);
    }

}


/* =========================================================
   8. STARS
========================================================= */

function addStars() {

    const geometry = new THREE.BufferGeometry();
    const positions = [];

    for (let i = 0; i &lt; 2500; i++) {

        positions.push(
            (Math.random() - 0.5) * 800,
            Math.random() * 350 + 20,
            (Math.random() - 0.5) * 800
        );

    }

    geometry.setAttribute(
        &quot;position&quot;,
        new THREE.Float32BufferAttribute(positions, 3)
    );

    const stars = new THREE.Points(
        geometry,
        new THREE.PointsMaterial({
            color: 0xffffff,
            size: 0.8
        })
    );

    scene.add(stars);

}


/* =========================================================
   9. BASIC 3D OBJECTS
========================================================= */

function addBox(parent, x, y, z, sx, sy, sz, mat) {

    const mesh = new THREE.Mesh(
        new THREE.BoxGeometry(sx, sy, sz),
        mat
    );

    mesh.position.set(x, y, z);
    parent.add(mesh);

    return mesh;
}


function addCylinder(parent, x, y, z, radiusTop, radiusBottom, height, mat) {

    const mesh = new THREE.Mesh(
        new THREE.CylinderGeometry(
            radiusTop,
            radiusBottom,
            height,
            16
        ),
        mat
    );

    mesh.position.set(x, y, z);
    parent.add(mesh);

    return mesh;
}


/* =========================================================
   10. APOLLO LUNAR MODULE
========================================================= */

function createApolloModule() {

    const group = new THREE.Group();

    const gold = material(0xb99b5c, 0.55, 0.55);
    const silver = material(0xbfc6c9, 0.5, 0.65);
    const dark = material(0x252b31, 0.7, 0.3);
    const glass = new THREE.MeshStandardMaterial({
        color: 0x172e40,
        metalness: 0.8,
        roughness: 0.2
    });

    addBox(group, 0, 2.8, 0, 4, 1.8, 3.5, gold);

    addBox(group, 0, 4.3, 0, 2.8, 1.5, 2.5, gold);

    addBox(group, 0, 4.3, -1.3, 1.2, 0.8, 0.1, glass);

    addCylinder(group, 0, 1.2, 0, 0.5, 0.7, 2, dark);

    for (let i = 0; i &lt; 4; i++) {

        const angle = i * Math.PI / 2;

        const leg = new THREE.Mesh(
            new THREE.CylinderGeometry(0.08, 0.12, 2.7, 8),
            silver
        );

        leg.position.set(
            Math.cos(angle) * 2.3,
            1.3,
            Math.sin(angle) * 2
        );

        leg.rotation.z = Math.cos(angle) * 0.3;
        leg.rotation.x = Math.sin(angle) * 0.3;

        group.add(leg);

    }

    group.position.set(0, 0, -8);
    group.scale.set(1.5, 1.5, 1.5);

    scene.add(group);

}


/* =========================================================
   11. LUNAR ROVING VEHICLE
========================================================= */

function createLunarRover() {

    const group = new THREE.Group();

    const frame = material(0xb9b9ad, 0.55, 0.65);
    const dark = material(0x24282d, 0.8, 0.2);
    const gold = material(0xb99b5c, 0.5, 0.6);

    addBox(group, 0, 1.7, 0, 4.5, 0.25, 2.4, frame);

    addBox(group, 0, 2.1, -0.2, 1.5, 0.5, 1.2, gold);

    addBox(group, 0, 2.8, -0.8, 0.8, 1.2, 0.1, dark);

    for (let side of [-1, 1]) {

        for (let front of [-1, 1]) {

            const wheel = new THREE.Mesh(
                new THREE.CylinderGeometry(0.8, 0.8, 0.35, 16),
                dark
            );

            wheel.rotation.z = Math.PI / 2;

            wheel.position.set(
                side * 2.2,
                0.8,
                front * 1.2
            );

            group.add(wheel);

        }

    }

    group.position.set(0, 0, -8);
    group.scale.set(1.4, 1.4, 1.4);

    scene.add(group);

}


/* =========================================================
   12. SOJOURNER ROVER
========================================================= */

function createSojourner() {

    const group = new THREE.Group();

    const body = material(0xc5a35a, 0.55, 0.5);
    const dark = material(0x252525, 0.8, 0.2);
    const silver = material(0x9da8ad, 0.5, 0.6);

    addBox(group, 0, 1.5, 0, 2.5, 1.1, 2.1, body);

    addBox(group, 0, 2.2, -0.4, 1.4, 0.15, 1.1, silver);

    addBox(group, 0, 2.8, 0, 0.2, 1.5, 0.2, silver);

    for (let side of [-1, 1]) {

        for (let front of [-1, 1]) {

            const wheel = new THREE.Mesh(
                new THREE.CylinderGeometry(0.5, 0.5, 0.3, 12),
                dark
            );

            wheel.rotation.z = Math.PI / 2;

            wheel.position.set(
                side * 1.35,
                0.65,
                front * 1
            );

            group.add(wheel);

        }

    }

    group.position.set(0, 0, -8);
    group.scale.set(1.6, 1.6, 1.6);

    scene.add(group);

}


/* =========================================================
   13. INGENUITY HELICOPTER
========================================================= */

function createIngenuity() {

    const group = new THREE.Group();

    const body = material(0x252a2e, 0.5, 0.7);
    const gold = material(0xc4a35b, 0.4, 0.6);
    const blade = material(0x262a30, 0.5, 0.7);

    addBox(group, 0, 2.5, 0, 1.2, 0.7, 1.2, body);

    addBox(group, 0, 3.1, 0, 0.4, 0.8, 0.4, gold);

    addCylinder(group, 0, 3.7, 0, 0.12, 0.12, 0.5, body);

    const rotor1 = addBox(
        group, 0, 4, 0, 7, 0.08, 0.18, blade
    );

    const rotor2 = addBox(
        group, 0, 4.1, 0, 0.18, 0.08, 7, blade
    );

    for (let side of [-1, 1]) {

        const leg = new THREE.Mesh(
            new THREE.CylinderGeometry(0.05, 0.05, 2, 8),
            body
        );

        leg.position.set(side * 0.8, 1.2, 0);
        group.add(leg);

    }

    group.position.set(0, 0, -8);
    group.scale.set(1.2, 1.2, 1.2);

    scene.add(group);

    group.userData.rotor1 = rotor1;
    group.userData.rotor2 = rotor2;

    scene.userData.ingenuity = group;

}


/* =========================================================
   14. DISCOVERY OBJECTS
========================================================= */

function createDiscovery(index, data) {

    const group = new THREE.Group();

    const color = selectedMission.location === &quot;MARS&quot;
        ? 0xff9b70
        : 0x55c8ff;

    const marker = new THREE.Mesh(
        new THREE.OctahedronGeometry(0.55, 0),
        new THREE.MeshStandardMaterial({
            color,
            emissive: color,
            emissiveIntensity: 0.7
        })
    );

    const ring = new THREE.Mesh(
        new THREE.TorusGeometry(0.9, 0.035, 8, 40),
        new THREE.MeshBasicMaterial({
            color
        })
    );

    ring.rotation.x = Math.PI / 2;

    group.add(marker);
    group.add(ring);

    group.position.set(
        [-12, 12, 0][index],
        1.5,
        [-12, -22, -35][index]
    );

    group.userData.discoveryIndex = index;
    group.userData.discoveryData = data;

    scene.add(group);

    discoveries.push(group);

}


/* =========================================================
   15. CREATE ENVIRONMENT
========================================================= */

function createEnvironment() {

    const isMars = selectedMission.location === &quot;MARS&quot;;

    scene = new THREE.Scene();

    scene.background = new THREE.Color(
        isMars ? 0xb66b4b : 0x03060d
    );

    scene.fog = new THREE.Fog(
        isMars ? 0xa45a3c : 0x080d17,
        45,
        250
    );

    camera = new THREE.PerspectiveCamera(
        75,
        window.innerWidth / window.innerHeight,
        0.1,
        1000
    );

    camera.position.copy(playerPosition);

    renderer = new THREE.WebGLRenderer({
        antialias: true
    });

    renderer.setPixelRatio(
        Math.min(window.devicePixelRatio, 2)
    );

    renderer.setSize(
        window.innerWidth,
        window.innerHeight
    );

    renderer.shadowMap.enabled = true;

    document.getElementById(&quot;three-container&quot;).innerHTML = &quot;&quot;;

    document.getElementById(&quot;three-container&quot;).appendChild(
        renderer.domElement
    );

    clock = new THREE.Clock();

    const ambient = new THREE.AmbientLight(
        0xffffff,
        isMars ? 1.1 : 0.65
    );

    scene.add(ambient);

    const sun = new THREE.DirectionalLight(
        0xffffff,
        isMars ? 1.5 : 1.2
    );

    sun.position.set(30, 60, 20);
    scene.add(sun);

    createTerrain(isMars);
    addRocks(isMars, 130);

    if (!isMars) {
        addStars();
    }

    switch (Object.keys(missions).find(key =&gt; missions[key] === selectedMission)) {

        case &quot;apollo&quot;:
            createApolloModule();
            break;

        case &quot;lrv&quot;:
            createLunarRover();
            break;

        case &quot;sojourner&quot;:
            createSojourner();
            break;

        case &quot;ingenuity&quot;:
            createIngenuity();
            break;

    }

    discoveries = [];

    selectedMission.discoveries.forEach((data, index) =&gt; {
        createDiscovery(index, data);
    });

}


/* =========================================================
   16. START EXPLORATION
========================================================= */

function startExploration() {

    if (!selectedMission) return;

    cancelAnimationFrame(animationFrame);

    playerPosition.set(0, 2, 12);

    yaw = 0;
    pitch = 0;

    keys = {};
    foundDiscoveries = [];
    activeDiscovery = null;

    isPaused = false;
    isExploring = true;

    document.getElementById(&quot;pause-message&quot;).classList.remove(&quot;show&quot;);
    document.getElementById(&quot;discovery-message&quot;).classList.remove(&quot;show&quot;);

    document.getElementById(&quot;game-mission-number&quot;).textContent =
        &quot;MISSION &quot; + selectedMission.number;

    document.getElementById(&quot;game-mission-title&quot;).textContent =
        selectedMission.name;

    document.getElementById(&quot;current-location&quot;).textContent =
        selectedMission.location + &quot; / &quot; + selectedMission.destination;

    document.getElementById(&quot;objective-description&quot;).textContent =
        selectedMission.objective;

    updateProgress();

    createEnvironment();

    animate();

}


/* =========================================================
   17. PLAYER MOVEMENT
========================================================= */

document.addEventListener(&quot;keydown&quot;, event =&gt; {

    keys[event.code] = true;

    if (event.code === &quot;KeyE&quot;) {
        investigate();
    }

});

document.addEventListener(&quot;keyup&quot;, event =&gt; {
    keys[event.code] = false;
});


function updateMovement(delta) {

    if (!camera || !isExploring || isPaused) return;

    const speed = 12 * delta;

    const forward = new THREE.Vector3(
        -Math.sin(yaw),
        0,
        -Math.cos(yaw)
    );

    const right = new THREE.Vector3(
        Math.cos(yaw),
        0,
        -Math.sin(yaw)
    );

    if (keys[&quot;KeyW&quot;] || keys[&quot;ArrowUp&quot;]) {
        playerPosition.addScaledVector(forward, speed);
    }

    if (keys[&quot;KeyS&quot;] || keys[&quot;ArrowDown&quot;]) {
        playerPosition.addScaledVector(forward, -speed);
    }

    if (keys[&quot;KeyA&quot;] || keys[&quot;ArrowLeft&quot;]) {
        playerPosition.addScaledVector(right, -speed);
    }

    if (keys[&quot;KeyD&quot;] || keys[&quot;ArrowRight&quot;]) {
        playerPosition.addScaledVector(right, speed);
    }

    playerPosition.x = THREE.MathUtils.clamp(
        playerPosition.x, -100, 100
    );

    playerPosition.z = THREE.MathUtils.clamp(
        playerPosition.z, -100, 100
    );

    camera.position.copy(playerPosition);

    camera.rotation.order = &quot;YXZ&quot;;
    camera.rotation.y = yaw;
    camera.rotation.x = pitch;

}


/* =========================================================
   18. MOUSE LOOK
========================================================= */

const gameCanvasContainer =
    document.getElementById(&quot;three-container&quot;);

gameCanvasContainer.addEventListener(&quot;click&quot;, () =&gt; {

    if (!isExploring || isPaused) return;

    if (document.pointerLockElement !== gameCanvasContainer) {
        gameCanvasContainer.requestPointerLock();
    }

});

document.addEventListener(&quot;mousemove&quot;, event =&gt; {

    if (document.pointerLockElement !== gameCanvasContainer) return;

    yaw -= event.movementX * 0.002;
    pitch -= event.movementY * 0.002;

    pitch = THREE.MathUtils.clamp(
        pitch,
        -1.3,
        1.3
    );

});


document.addEventListener(&quot;pointerlockchange&quot;, () =&gt; {

    if (!isExploring) return;

    const locked =
        document.pointerLockElement === gameCanvasContainer;

    isPaused = !locked;

    document.getElementById(&quot;pause-message&quot;)
        .classList.toggle(&quot;show&quot;, !locked);

});


document.getElementById(&quot;pause-message&quot;).addEventListener(&quot;click&quot;, () =&gt; {

    if (isExploring &amp;&amp; !isPaused) return;

    gameCanvasContainer.requestPointerLock();

});


/* =========================================================
   19. DISCOVERY DETECTION
========================================================= */

function checkNearbyDiscoveries() {

    if (!camera || !isExploring || isPaused) return;

    activeDiscovery = null;

    let closestDistance = 4;

    discoveries.forEach(discovery =&gt; {

        const index = discovery.userData.discoveryIndex;

        if (foundDiscoveries.includes(index)) return;

        const distance = camera.position.distanceTo(
            discovery.position
        );

        if (distance &lt; closestDistance) {

            closestDistance = distance;
            activeDiscovery = discovery;

        }

    });

    document.getElementById(&quot;interaction-prompt&quot;).style.display =
        activeDiscovery ? &quot;block&quot; : &quot;none&quot;;

}


/* =========================================================
   20. INVESTIGATE
========================================================= */

function investigate() {

    if (!activeDiscovery || isPaused || !isExploring) return;

    const index = activeDiscovery.userData.discoveryIndex;

    if (foundDiscoveries.includes(index)) return;

    foundDiscoveries.push(index);

    const data = activeDiscovery.userData.discoveryData;

    document.getElementById(&quot;discovery-title&quot;).textContent =
        data.name;

    document.getElementById(&quot;discovery-description&quot;).textContent =
        data.description;

    document.getElementById(&quot;discovery-message&quot;)
        .classList.add(&quot;show&quot;);

    document.getElementById(&quot;interaction-prompt&quot;).style.display =
        &quot;none&quot;;

    activeDiscovery.visible = false;

    updateProgress();

}


document.getElementById(&quot;close-discovery&quot;).addEventListener(&quot;click&quot;, () =&gt; {

    document.getElementById(&quot;discovery-message&quot;)
        .classList.remove(&quot;show&quot;);

    if (foundDiscoveries.length === selectedMission.discoveries.length) {
        completeMission();
    }

});


/* =========================================================
   21. PROGRESS
========================================================= */

function updateProgress() {

    const total = selectedMission.discoveries.length;
    const current = foundDiscoveries.length;

    const percentage = (current / total) * 100;

    document.getElementById(&quot;objective-progress&quot;).textContent =
        current + &quot; / &quot; + total + &quot; DISCOVERIES&quot;;

    document.getElementById(&quot;progress-fill&quot;).style.width =
        percentage + &quot;%&quot;;

}


/* =========================================================
   22. MINIMAP
========================================================= */

function drawMap() {

    const canvas = document.getElementById(&quot;map-canvas&quot;);
    const ctx = canvas.getContext(&quot;2d&quot;);

    const width = canvas.width;
    const height = canvas.height;

    ctx.clearRect(0, 0, width, height);

    ctx.fillStyle = &quot;rgba(15,25,38,0.95)&quot;;
    ctx.fillRect(0, 0, width, height);

    ctx.strokeStyle = &quot;rgba(85,200,255,0.18)&quot;;
    ctx.lineWidth = 1;

    for (let i = 0; i &lt;= width; i += 30) {
        ctx.beginPath();
        ctx.moveTo(i, 0);
        ctx.lineTo(i, height);
        ctx.stroke();

        ctx.beginPath();
        ctx.moveTo(0, i);
        ctx.lineTo(width, i);
        ctx.stroke();
    }

    if (!playerPosition) return;

    const playerX = width / 2 + playerPosition.x * 0.5;
    const playerY = height / 2 + playerPosition.z * 0.5;

    ctx.fillStyle = &quot;#55c8ff&quot;;
    ctx.beginPath();
    ctx.arc(playerX, playerY, 4, 0, Math.PI * 2);
    ctx.fill();

    discoveries.forEach(discovery =&gt; {

        const index = discovery.userData.discoveryIndex;

        if (foundDiscoveries.includes(index)) return;

        const x = width / 2 + discovery.position.x * 0.5;
        const y = height / 2 + discovery.position.z * 0.5;

        ctx.fillStyle = &quot;#ffb36a&quot;;
        ctx.beginPath();
        ctx.arc(x, y, 3, 0, Math.PI * 2);
        ctx.fill();

    });

}


/* =========================================================
   23. COMPLETE MISSION
========================================================= */

function completeMission() {

    isExploring = false;

    if (document.pointerLockElement) {
        document.exitPointerLock();
    }

    document.getElementById(&quot;complete-mission-name&quot;).textContent =
        selectedMission.name;

    document.getElementById(&quot;complete-discoveries&quot;).textContent =
        foundDiscoveries.length + &quot; / &quot; +
        selectedMission.discoveries.length;

    document.getElementById(&quot;complete-description&quot;).textContent =
        &quot;You have investigated the environment and completed all objectives. Your discoveries have been added to the NOVA mission report.&quot;;

    showScreen(&quot;complete-screen&quot;);

    cancelAnimationFrame(animationFrame);

}


/* =========================================================
   24. EXIT MISSION
========================================================= */

document.getElementById(&quot;exit-exploration&quot;).addEventListener(&quot;click&quot;, () =&gt; {

    isExploring = false;

    if (document.pointerLockElement) {
        document.exitPointerLock();
    }

    cancelAnimationFrame(animationFrame);

    showScreen(&quot;briefing-screen&quot;);

});


document.getElementById(&quot;return-home&quot;).addEventListener(&quot;click&quot;, () =&gt; {

    isExploring = false;

    cancelAnimationFrame(animationFrame);

    showScreen(&quot;home-screen&quot;);

});


/* =========================================================
   25. ANIMATION LOOP
========================================================= */

function animate() {

    if (!isExploring) return;

    animationFrame = requestAnimationFrame(animate);

    const delta = Math.min(clock.getDelta(), 0.05);

    if (!isPaused) {

        updateMovement(delta);
        checkNearbyDiscoveries();

        discoveries.forEach((discovery, index) =&gt; {

            if (discovery.visible) {

                discovery.rotation.y += delta * 0.8;

                discovery.position.y =
                    1.5 + Math.sin(Date.now() * 0.002 + index) * 0.2;

            }

        });

        const ingenuity = scene.userData.ingenuity;

        if (ingenuity) {

            if (ingenuity.userData.rotor1) {
                ingenuity.userData.rotor1.rotation.y += delta * 8;
            }

            if (ingenuity.userData.rotor2) {
                ingenuity.userData.rotor2.rotation.x += delta * 8;
            }

        }

    }

    if (camera) {
        camera.position.copy(playerPosition);
    }

    drawMap();

    renderer.render(scene, camera);

}


/* =========================================================
   26. WINDOW RESIZE
========================================================= */

window.addEventListener(&quot;resize&quot;, () =&gt; {

    if (!camera || !renderer) return;

    camera.aspect =
        window.innerWidth / window.innerHeight;

    camera.updateProjectionMatrix();

    renderer.setSize(
        window.innerWidth,
        window.innerHeight
    );

});" class="CodeBlock-zu1QM3"><div data-code-block="true" data-markdown-copy="code-block" data-theme="dark" class="relative Root-iW7ipz w-full min-w-0 contain-inline-size overflow-clip rounded-(--radius-3xl-base) border border-subtle text-default CodeSurface-UAMd1A Surface-BCuIs1 dark @container" data-search-result-target=""><div data-markdown-copy="exclude" contenteditable="false" class="flex items-center font-sans text-sm select-none gap-2 ActionBar-KWWAct min-h-12 py-1.5 ps-4 pe-1.5 font-medium text-default md:ps-5 sticky z-10 StickyActionBar-RZfVQh"><svg aria-hidden="true" class="Icon-X4VkKC" focusable="false" height="20" viewBox="0 0 20 20" width="20" xmlns="http://www.w3.org/2000/svg"><use href="/cdn/assets/icons-65c0f11497ac4847.svg#codex-icon-code-light-20" fill="currentColor"></use></svg><div class="min-w-0 truncate flex-1">JavaScript</div><div class="ms-auto flex items-center min-w-0 max-w-full"><div data-code-block-controls="true" role="presentation" class="flex min-w-0 items-center gap-px print:hidden flex-wrap justify-end"><button type="button" class="no-drag cursor-interaction items-center select-none disabled:cursor-default aria-disabled:cursor-default focus:outline-hidden disabled:opacity-40 aria-disabled:opacity-40 focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-0 whitespace-nowrap flex border gap-1 rounded-full text-default not-disabled:not-aria-disabled:hover:bg-secondary-ghost-hover data-[state=open]:bg-secondary-ghost-hover aria-pressed:bg-secondary-ghost-hover border-transparent h-9 gap-1.5 border-0 px-2 py-0 text-sm leading-5 aspect-square shrink-0 items-center justify-center !px-0" aria-label="Activar ajuste de línea" aria-pressed="false" data-state="closed"><svg aria-hidden="true" class="Icon-X4VkKC" focusable="false" height="20" viewBox="0 0 20 20" width="20" xmlns="http://www.w3.org/2000/svg"><use href="/cdn/assets/icons-65c0f11497ac4847.svg#codex-icon-text-overflow-light-20" fill="currentColor"></use></svg></button><button type="button" class="no-drag cursor-interaction items-center select-none disabled:cursor-default aria-disabled:cursor-default focus:outline-hidden disabled:opacity-40 aria-disabled:opacity-40 focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-0 whitespace-nowrap flex border gap-1 rounded-full text-default not-disabled:not-aria-disabled:hover:bg-secondary-ghost-hover data-[state=open]:bg-secondary-ghost-hover aria-pressed:bg-secondary-ghost-hover border-transparent h-9 gap-1.5 border-0 px-2 py-0 text-sm leading-5 aspect-square shrink-0 items-center justify-center !px-0" aria-label="Copiar código" data-state="closed"><svg aria-hidden="true" class="Icon-X4VkKC" focusable="false" height="20" viewBox="0 0 20 20" width="20" xmlns="http://www.w3.org/2000/svg"><use href="/cdn/assets/icons-65c0f11497ac4847.svg#codex-icon-square-on-square-light-20" fill="currentColor"></use></svg></button></div></div></div><div class="relative [container-type:inline-size]"><div class="InlineCodePane-EYx4bd w-full overflow-x-hidden"><div class="relative z-0 flex max-w-full Viewer-ALA646" dir="ltr"><div class="chatgpt-code-scrollport flex w-full items-stretch overscroll-x-contain Scrollport-kY3Nlm overflow-x-auto"><pre class="m-0 flex-1 cursor-text px-4 pb-3 font-mono text-size-code text-default md:px-5 ViewerContent-Cg8AgN pt-0 min-w-max whitespace-pre"><code><span class="Comment-dh5VVn">/* =========================================================</span><span>
</span><span class="Comment-dh5VVn">   NOVA SPACE EXPLORATION</span><span>
</span><span class="Comment-dh5VVn">   MAIN INTERACTIVE SYSTEM</span><span>
</span><span class="Comment-dh5VVn">   THREE.JS r128</span><span>
</span><span class="Comment-dh5VVn">========================================================= */</span><span>


</span><span class="Comment-dh5VVn">/* =========================================================</span><span>
</span><span class="Comment-dh5VVn">   1. MISSION DATABASE</span><span>
</span><span class="Comment-dh5VVn">========================================================= */</span><span>

</span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">missions </span><span class="text-codex-syntax-keyword">= </span><span>{

    </span><span class="text-codex-syntax-attribute">apollo</span><span>: {
        </span><span class="text-codex-syntax-attribute">number</span><span>: </span><span class="text-codex-syntax-string">"001"</span><span>,
        </span><span class="text-codex-syntax-attribute">name</span><span>: </span><span class="text-codex-syntax-string">"APOLLO LUNAR MODULE"</span><span>,
        </span><span class="text-codex-syntax-attribute">location</span><span>: </span><span class="text-codex-syntax-string">"THE MOON"</span><span>,
        </span><span class="text-codex-syntax-attribute">destination</span><span>: </span><span class="text-codex-syntax-string">"SEA OF TRANQUILITY"</span><span>,
        </span><span class="text-codex-syntax-attribute">type</span><span>: </span><span class="text-codex-syntax-string">"LUNAR LANDING SYSTEM"</span><span>,
        </span><span class="text-codex-syntax-attribute">year</span><span>: </span><span class="text-codex-syntax-string">"1969"</span><span>,
        </span><span class="text-codex-syntax-attribute">image</span><span>: </span><span class="text-codex-syntax-string">"images/apollo-module.jpg"</span><span>,

        </span><span class="text-codex-syntax-attribute">description</span><span>:
            </span><span class="text-codex-syntax-string">"The Apollo Lunar Module was the spacecraft designed to transport astronauts from lunar orbit to the Moon's surface. Its descent stage remained on the Moon after the astronauts returned to orbit."</span><span>,

        </span><span class="text-codex-syntax-attribute">objective</span><span>:
            </span><span class="text-codex-syntax-string">"Investigate the lunar module and identify the main components of the historic landing system."</span><span>,

        </span><span class="text-codex-syntax-attribute">discoveries</span><span>: [
            {
                </span><span class="text-codex-syntax-attribute">name</span><span>: </span><span class="text-codex-syntax-string">"DESCENT STAGE"</span><span>,
                </span><span class="text-codex-syntax-attribute">description</span><span>:
                    </span><span class="text-codex-syntax-string">"The descent stage supported the lunar module during landing. It remained on the Moon and served as the launch platform for the ascent stage."</span><span>
</span><span class="text-codex-syntax-string">            </span><span>},
            {
                </span><span class="text-codex-syntax-attribute">name</span><span>: </span><span class="text-codex-syntax-string">"LANDING LEGS"</span><span>,
                </span><span class="text-codex-syntax-attribute">description</span><span>:
                    </span><span class="text-codex-syntax-string">"The landing legs absorbed the impact of touchdown and supported the lunar module on the lunar surface."</span><span>
</span><span class="text-codex-syntax-string">            </span><span>},
            {
                </span><span class="text-codex-syntax-attribute">name</span><span>: </span><span class="text-codex-syntax-string">"LUNAR SURFACE"</span><span>,
                </span><span class="text-codex-syntax-attribute">description</span><span>:
                    </span><span class="text-codex-syntax-string">"The Sea of Tranquility was the landing region of Apollo 11 on July 20, 1969."</span><span>
</span><span class="text-codex-syntax-string">            </span><span>}
        ]
    },

    </span><span class="text-codex-syntax-attribute">lrv</span><span>: {
        </span><span class="text-codex-syntax-attribute">number</span><span>: </span><span class="text-codex-syntax-string">"002"</span><span>,
        </span><span class="text-codex-syntax-attribute">name</span><span>: </span><span class="text-codex-syntax-string">"LUNAR ROVING VEHICLE"</span><span>,
        </span><span class="text-codex-syntax-attribute">location</span><span>: </span><span class="text-codex-syntax-string">"THE MOON"</span><span>,
        </span><span class="text-codex-syntax-attribute">destination</span><span>: </span><span class="text-codex-syntax-string">"APOLLO EXPLORATION REGION"</span><span>,
        </span><span class="text-codex-syntax-attribute">type</span><span>: </span><span class="text-codex-syntax-string">"CREWED ELECTRIC VEHICLE"</span><span>,
        </span><span class="text-codex-syntax-attribute">year</span><span>: </span><span class="text-codex-syntax-string">"1971–1972"</span><span>,
        </span><span class="text-codex-syntax-attribute">image</span><span>: </span><span class="text-codex-syntax-string">"images/lunar-rover.jpg"</span><span>,

        </span><span class="text-codex-syntax-attribute">description</span><span>:
            </span><span class="text-codex-syntax-string">"The Lunar Roving Vehicle was an electric vehicle used by astronauts during Apollo 15, Apollo 16 and Apollo 17. It expanded the distance astronauts could explore on the lunar surface."</span><span>,

        </span><span class="text-codex-syntax-attribute">objective</span><span>:
            </span><span class="text-codex-syntax-string">"Explore the lunar rover and investigate its mobility system, scientific equipment and structure."</span><span>,

        </span><span class="text-codex-syntax-attribute">discoveries</span><span>: [
            {
                </span><span class="text-codex-syntax-attribute">name</span><span>: </span><span class="text-codex-syntax-string">"ROVER WHEELS"</span><span>,
                </span><span class="text-codex-syntax-attribute">description</span><span>:
                    </span><span class="text-codex-syntax-string">"The LRV used four specially designed wheels to travel across the Moon's rough surface."</span><span>
</span><span class="text-codex-syntax-string">            </span><span>},
            {
                </span><span class="text-codex-syntax-attribute">name</span><span>: </span><span class="text-codex-syntax-string">"NAVIGATION SYSTEM"</span><span>,
                </span><span class="text-codex-syntax-attribute">description</span><span>:
                    </span><span class="text-codex-syntax-string">"The rover included navigation equipment that helped astronauts monitor their position and direction."</span><span>
</span><span class="text-codex-syntax-string">            </span><span>},
            {
                </span><span class="text-codex-syntax-attribute">name</span><span>: </span><span class="text-codex-syntax-string">"SCIENTIFIC EQUIPMENT"</span><span>,
                </span><span class="text-codex-syntax-attribute">description</span><span>:
                    </span><span class="text-codex-syntax-string">"The rover carried equipment and tools that helped astronauts collect geological samples and investigate the Moon."</span><span>
</span><span class="text-codex-syntax-string">            </span><span>}
        ]
    },

    </span><span class="text-codex-syntax-attribute">sojourner</span><span>: {
        </span><span class="text-codex-syntax-attribute">number</span><span>: </span><span class="text-codex-syntax-string">"003"</span><span>,
        </span><span class="text-codex-syntax-attribute">name</span><span>: </span><span class="text-codex-syntax-string">"SOJOURNER ROVER"</span><span>,
        </span><span class="text-codex-syntax-attribute">location</span><span>: </span><span class="text-codex-syntax-string">"MARS"</span><span>,
        </span><span class="text-codex-syntax-attribute">destination</span><span>: </span><span class="text-codex-syntax-string">"AREAS VALLIS"</span><span>,
        </span><span class="text-codex-syntax-attribute">type</span><span>: </span><span class="text-codex-syntax-string">"ROBOTIC ROVER"</span><span>,
        </span><span class="text-codex-syntax-attribute">year</span><span>: </span><span class="text-codex-syntax-string">"1997"</span><span>,
        </span><span class="text-codex-syntax-attribute">image</span><span>: </span><span class="text-codex-syntax-string">"images/sojourner.jpg"</span><span>,

        </span><span class="text-codex-syntax-attribute">description</span><span>:
            </span><span class="text-codex-syntax-string">"Sojourner was the first successful robotic rover to operate on Mars. It arrived with the Mars Pathfinder lander in 1997 and studied nearby rocks and soil."</span><span>,

        </span><span class="text-codex-syntax-attribute">objective</span><span>:
            </span><span class="text-codex-syntax-string">"Investigate the Martian environment and discover how the first rover studied the planet."</span><span>,

        </span><span class="text-codex-syntax-attribute">discoveries</span><span>: [
            {
                </span><span class="text-codex-syntax-attribute">name</span><span>: </span><span class="text-codex-syntax-string">"ROBOTIC WHEELS"</span><span>,
                </span><span class="text-codex-syntax-attribute">description</span><span>:
                    </span><span class="text-codex-syntax-string">"Sojourner used six wheels to move across the Martian terrain and approach rocks for scientific investigation."</span><span>
</span><span class="text-codex-syntax-string">            </span><span>},
            {
                </span><span class="text-codex-syntax-attribute">name</span><span>: </span><span class="text-codex-syntax-string">"ALPHA PROTON X-RAY SPECTROMETER"</span><span>,
                </span><span class="text-codex-syntax-attribute">description</span><span>:
                    </span><span class="text-codex-syntax-string">"This instrument helped scientists analyze the chemical composition of Martian rocks and soil."</span><span>
</span><span class="text-codex-syntax-string">            </span><span>},
            {
                </span><span class="text-codex-syntax-attribute">name</span><span>: </span><span class="text-codex-syntax-string">"MARS PATHFINDER"</span><span>,
                </span><span class="text-codex-syntax-attribute">description</span><span>:
                    </span><span class="text-codex-syntax-string">"The Pathfinder lander delivered Sojourner to Mars and served as its communication link with Earth."</span><span>
</span><span class="text-codex-syntax-string">            </span><span>}
        ]
    },

    </span><span class="text-codex-syntax-attribute">ingenuity</span><span>: {
        </span><span class="text-codex-syntax-attribute">number</span><span>: </span><span class="text-codex-syntax-string">"004"</span><span>,
        </span><span class="text-codex-syntax-attribute">name</span><span>: </span><span class="text-codex-syntax-string">"INGENUITY HELICOPTER"</span><span>,
        </span><span class="text-codex-syntax-attribute">location</span><span>: </span><span class="text-codex-syntax-string">"MARS"</span><span>,
        </span><span class="text-codex-syntax-attribute">destination</span><span>: </span><span class="text-codex-syntax-string">"JEZERO CRATER"</span><span>,
        </span><span class="text-codex-syntax-attribute">type</span><span>: </span><span class="text-codex-syntax-string">"ROBOTIC HELICOPTER"</span><span>,
        </span><span class="text-codex-syntax-attribute">year</span><span>: </span><span class="text-codex-syntax-string">"2021–2024"</span><span>,
        </span><span class="text-codex-syntax-attribute">image</span><span>: </span><span class="text-codex-syntax-string">"images/ingenuity.jpg"</span><span>,

        </span><span class="text-codex-syntax-attribute">description</span><span>:
            </span><span class="text-codex-syntax-string">"NASA's Ingenuity helicopter became the first aircraft to achieve powered, controlled flight on another planet. It operated on Mars alongside the Perseverance rover."</span><span>,

        </span><span class="text-codex-syntax-attribute">objective</span><span>:
            </span><span class="text-codex-syntax-string">"Investigate the helicopter's design, flight system and exploration role on Mars."</span><span>,

        </span><span class="text-codex-syntax-attribute">discoveries</span><span>: [
            {
                </span><span class="text-codex-syntax-attribute">name</span><span>: </span><span class="text-codex-syntax-string">"ROTOR SYSTEM"</span><span>,
                </span><span class="text-codex-syntax-attribute">description</span><span>:
                    </span><span class="text-codex-syntax-string">"Ingenuity used two counter-rotating rotor blades to generate lift in the extremely thin Martian atmosphere."</span><span>
</span><span class="text-codex-syntax-string">            </span><span>},
            {
                </span><span class="text-codex-syntax-attribute">name</span><span>: </span><span class="text-codex-syntax-string">"SOLAR PANEL"</span><span>,
                </span><span class="text-codex-syntax-attribute">description</span><span>:
                    </span><span class="text-codex-syntax-string">"A solar panel collected energy to recharge the helicopter's batteries and support its operations."</span><span>
</span><span class="text-codex-syntax-string">            </span><span>},
            {
                </span><span class="text-codex-syntax-attribute">name</span><span>: </span><span class="text-codex-syntax-string">"FLIGHT LANDING AREA"</span><span>,
                </span><span class="text-codex-syntax-attribute">description</span><span>:
                    </span><span class="text-codex-syntax-string">"Ingenuity demonstrated that powered flight was possible on Mars. Its mission ended in January 2024 after rotor damage."</span><span>
</span><span class="text-codex-syntax-string">            </span><span>}
        ]
    }

};


</span><span class="Comment-dh5VVn">/* =========================================================</span><span>
</span><span class="Comment-dh5VVn">   2. SCREEN NAVIGATION</span><span>
</span><span class="Comment-dh5VVn">========================================================= */</span><span>

</span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">screens </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">document</span><span>.</span><span class="text-codex-syntax-variable">querySelectorAll</span><span>(</span><span class="text-codex-syntax-string">".screen"</span><span>);

</span><span class="text-codex-syntax-keyword">function </span><span class="text-codex-syntax-variable">showScreen</span><span>(</span><span class="text-codex-syntax-variable">id</span><span>) {
    </span><span class="text-codex-syntax-variable">screens</span><span>.</span><span class="text-codex-syntax-variable">forEach</span><span>(</span><span class="text-codex-syntax-variable">screen </span><span class="text-codex-syntax-keyword">=&gt; </span><span>{
        </span><span class="text-codex-syntax-variable">screen</span><span>.</span><span class="text-codex-syntax-attribute">classList</span><span>.</span><span class="text-codex-syntax-variable">remove</span><span>(</span><span class="text-codex-syntax-string">"active"</span><span>);
    });

    </span><span class="text-codex-syntax-variable">document</span><span>.</span><span class="text-codex-syntax-variable">getElementById</span><span>(</span><span class="text-codex-syntax-variable">id</span><span>).</span><span class="text-codex-syntax-attribute">classList</span><span>.</span><span class="text-codex-syntax-variable">add</span><span>(</span><span class="text-codex-syntax-string">"active"</span><span>);
}

</span><span class="text-codex-syntax-keyword">let </span><span class="text-codex-syntax-variable">selectedMission </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-literal">null</span><span>;

</span><span class="text-codex-syntax-variable">document</span><span>.</span><span class="text-codex-syntax-variable">querySelectorAll</span><span>(</span><span class="text-codex-syntax-string">".mission-card"</span><span>).</span><span class="text-codex-syntax-variable">forEach</span><span>(</span><span class="text-codex-syntax-variable">card </span><span class="text-codex-syntax-keyword">=&gt; </span><span>{
    </span><span class="text-codex-syntax-variable">card</span><span>.</span><span class="text-codex-syntax-variable">addEventListener</span><span>(</span><span class="text-codex-syntax-string">"click"</span><span>, () </span><span class="text-codex-syntax-keyword">=&gt; </span><span>{
        </span><span class="text-codex-syntax-variable">openMission</span><span>(</span><span class="text-codex-syntax-variable">card</span><span>.</span><span class="text-codex-syntax-attribute">dataset</span><span>.</span><span class="text-codex-syntax-attribute">mission</span><span>);
    });
});

</span><span class="text-codex-syntax-variable">document</span><span>.</span><span class="text-codex-syntax-variable">getElementById</span><span>(</span><span class="text-codex-syntax-string">"start-button"</span><span>).</span><span class="text-codex-syntax-variable">addEventListener</span><span>(</span><span class="text-codex-syntax-string">"click"</span><span>, () </span><span class="text-codex-syntax-keyword">=&gt; </span><span>{
    </span><span class="text-codex-syntax-variable">document</span><span>.</span><span class="text-codex-syntax-variable">querySelector</span><span>(</span><span class="text-codex-syntax-string">".missions-section"</span><span>).</span><span class="text-codex-syntax-variable">scrollIntoView</span><span>({
        </span><span class="text-codex-syntax-attribute">behavior</span><span>: </span><span class="text-codex-syntax-string">"smooth"</span><span>
</span><span class="text-codex-syntax-string">    </span><span>});
});

</span><span class="text-codex-syntax-variable">document</span><span>.</span><span class="text-codex-syntax-variable">getElementById</span><span>(</span><span class="text-codex-syntax-string">"back-home"</span><span>).</span><span class="text-codex-syntax-variable">addEventListener</span><span>(</span><span class="text-codex-syntax-string">"click"</span><span>, () </span><span class="text-codex-syntax-keyword">=&gt; </span><span>{
    </span><span class="text-codex-syntax-variable">showScreen</span><span>(</span><span class="text-codex-syntax-string">"home-screen"</span><span>);
});

</span><span class="text-codex-syntax-keyword">function </span><span class="text-codex-syntax-variable">openMission</span><span>(</span><span class="text-codex-syntax-variable">id</span><span>) {

    </span><span class="text-codex-syntax-variable">selectedMission </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">missions</span><span>[</span><span class="text-codex-syntax-variable">id</span><span>];

    </span><span class="text-codex-syntax-keyword">if </span><span>(</span><span class="text-codex-syntax-keyword">!</span><span class="text-codex-syntax-variable">selectedMission</span><span>) </span><span class="text-codex-syntax-keyword">return</span><span>;

    </span><span class="text-codex-syntax-variable">document</span><span>.</span><span class="text-codex-syntax-variable">getElementById</span><span>(</span><span class="text-codex-syntax-string">"briefing-image"</span><span>).</span><span class="text-codex-syntax-attribute">src </span><span class="text-codex-syntax-keyword">=</span><span>
</span><span class="text-codex-syntax-keyword">        </span><span class="text-codex-syntax-variable">selectedMission</span><span>.</span><span class="text-codex-syntax-attribute">image</span><span>;

    </span><span class="text-codex-syntax-variable">document</span><span>.</span><span class="text-codex-syntax-variable">getElementById</span><span>(</span><span class="text-codex-syntax-string">"briefing-number"</span><span>).</span><span class="text-codex-syntax-attribute">textContent </span><span class="text-codex-syntax-keyword">=</span><span>
</span><span class="text-codex-syntax-keyword">        </span><span class="text-codex-syntax-string">"MISSION " </span><span class="text-codex-syntax-keyword">+ </span><span class="text-codex-syntax-variable">selectedMission</span><span>.</span><span class="text-codex-syntax-attribute">number</span><span>;

    </span><span class="text-codex-syntax-variable">document</span><span>.</span><span class="text-codex-syntax-variable">getElementById</span><span>(</span><span class="text-codex-syntax-string">"briefing-location"</span><span>).</span><span class="text-codex-syntax-attribute">textContent </span><span class="text-codex-syntax-keyword">=</span><span>
</span><span class="text-codex-syntax-keyword">        </span><span class="text-codex-syntax-variable">selectedMission</span><span>.</span><span class="text-codex-syntax-attribute">location</span><span>;

    </span><span class="text-codex-syntax-variable">document</span><span>.</span><span class="text-codex-syntax-variable">getElementById</span><span>(</span><span class="text-codex-syntax-string">"briefing-title"</span><span>).</span><span class="text-codex-syntax-attribute">textContent </span><span class="text-codex-syntax-keyword">=</span><span>
</span><span class="text-codex-syntax-keyword">        </span><span class="text-codex-syntax-variable">selectedMission</span><span>.</span><span class="text-codex-syntax-attribute">name</span><span>;

    </span><span class="text-codex-syntax-variable">document</span><span>.</span><span class="text-codex-syntax-variable">getElementById</span><span>(</span><span class="text-codex-syntax-string">"briefing-description"</span><span>).</span><span class="text-codex-syntax-attribute">textContent </span><span class="text-codex-syntax-keyword">=</span><span>
</span><span class="text-codex-syntax-keyword">        </span><span class="text-codex-syntax-variable">selectedMission</span><span>.</span><span class="text-codex-syntax-attribute">description</span><span>;

    </span><span class="text-codex-syntax-variable">document</span><span>.</span><span class="text-codex-syntax-variable">getElementById</span><span>(</span><span class="text-codex-syntax-string">"briefing-destination"</span><span>).</span><span class="text-codex-syntax-attribute">textContent </span><span class="text-codex-syntax-keyword">=</span><span>
</span><span class="text-codex-syntax-keyword">        </span><span class="text-codex-syntax-variable">selectedMission</span><span>.</span><span class="text-codex-syntax-attribute">destination</span><span>;

    </span><span class="text-codex-syntax-variable">document</span><span>.</span><span class="text-codex-syntax-variable">getElementById</span><span>(</span><span class="text-codex-syntax-string">"briefing-type"</span><span>).</span><span class="text-codex-syntax-attribute">textContent </span><span class="text-codex-syntax-keyword">=</span><span>
</span><span class="text-codex-syntax-keyword">        </span><span class="text-codex-syntax-variable">selectedMission</span><span>.</span><span class="text-codex-syntax-attribute">type</span><span>;

    </span><span class="text-codex-syntax-variable">document</span><span>.</span><span class="text-codex-syntax-variable">getElementById</span><span>(</span><span class="text-codex-syntax-string">"briefing-year"</span><span>).</span><span class="text-codex-syntax-attribute">textContent </span><span class="text-codex-syntax-keyword">=</span><span>
</span><span class="text-codex-syntax-keyword">        </span><span class="text-codex-syntax-variable">selectedMission</span><span>.</span><span class="text-codex-syntax-attribute">year</span><span>;

    </span><span class="text-codex-syntax-variable">document</span><span>.</span><span class="text-codex-syntax-variable">getElementById</span><span>(</span><span class="text-codex-syntax-string">"briefing-objective"</span><span>).</span><span class="text-codex-syntax-attribute">textContent </span><span class="text-codex-syntax-keyword">=</span><span>
</span><span class="text-codex-syntax-keyword">        </span><span class="text-codex-syntax-variable">selectedMission</span><span>.</span><span class="text-codex-syntax-attribute">objective</span><span>;

    </span><span class="text-codex-syntax-variable">showScreen</span><span>(</span><span class="text-codex-syntax-string">"briefing-screen"</span><span>);
}


