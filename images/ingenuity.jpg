            &lt;</span><span class="text-codex-syntax-name">canvas </span><span class="text-codex-syntax-attribute">id</span><span>=</span><span class="text-codex-syntax-string">"map-canvas" </span><span class="text-codex-syntax-attribute">width</span><span>=</span><span class="text-codex-syntax-string">"150" </span><span class="text-codex-syntax-attribute">height</span><span>=</span><span class="text-codex-syntax-string">"150"</span><span>&gt;&lt;/</span><span class="text-codex-syntax-name">canvas</span><span>&gt;
            &lt;</span><span class="text-codex-syntax-name">span</span><span>&gt;EXPLORATION ZONE&lt;/</span><span class="text-codex-syntax-name">span</span><span>&gt;
