        &lt;</span><span class="text-codex-syntax-name">div </span><span class="text-codex-syntax-attribute">class</span><span>=</span><span class="text-codex-syntax-string">"complete-content"</span><span>&gt;
            &lt;</span><span class="text-codex-syntax-name">p </span><span class="text-codex-syntax-attribute">class</span><span>=</span><span class="text-codex-syntax-string">"eyebrow"</span><span>&gt;NOVA MISSION REPORT&lt;/</span><span class="text-codex-syntax-name">p</span><span>&gt;

            &lt;</span><span class="text-codex-syntax-name">div </span><span class="text-codex-syntax-attribute">class</span><span>=</span><span class="text-codex-syntax-string">"complete-symbol"</span><span>&gt;✓&lt;/</span><span class="text-codex-syntax-name">div</span><span>&gt;

            &lt;</span><span class="text-codex-syntax-name">h1</span><span>&gt;MISSION&lt;</span><span class="text-codex-syntax-name">br</span><span>&gt;&lt;</span><span class="text-codex-syntax-name">span</span><span>&gt;COMPLETED&lt;/</span><span class="text-codex-syntax-name">span</span><span>&gt;&lt;/</span><span class="text-codex-syntax-name">h1</span><span>&gt;

            &lt;</span><span class="text-codex-syntax-name">p </span><span class="text-codex-syntax-attribute">id</span><span>=</span><span class="text-codex-syntax-string">"complete-description"</span><span>&gt;
                All exploration objectives have been completed.
            &lt;/</span><span class="text-codex-syntax-name">p</span><span>&gt;

            &lt;</span><span class="text-codex-syntax-name">div </span><span class="text-codex-syntax-attribute">class</span><span>=</span><span class="text-codex-syntax-string">"complete-stats"</span><span>&gt;
                &lt;</span><span class="text-codex-syntax-name">div</span><span>&gt;
                    &lt;</span><span class="text-codex-syntax-name">span</span><span>&gt;MISSION&lt;/</span><span class="text-codex-syntax-name">span</span><span>&gt;
                    &lt;</span><span class="text-codex-syntax-name">strong </span><span class="text-codex-syntax-attribute">id</span><span>=</span><span class="text-codex-syntax-string">"complete-mission-name"</span><span>&gt;MISSION NAME&lt;/</span><span class="text-codex-syntax-name">strong</span><span>&gt;
                &lt;/</span><span class="text-codex-syntax-name">div</span><span>&gt;

                &lt;</span><span class="text-codex-syntax-name">div</span><span>&gt;
                    &lt;</span><span class="text-codex-syntax-name">span</span><span>&gt;DISCOVERIES&lt;/</span><span class="text-codex-syntax-name">span</span><span>&gt;
                    &lt;</span><span class="text-codex-syntax-name">strong </span><span class="text-codex-syntax-attribute">id</span><span>=</span><span class="text-codex-syntax-string">"complete-discoveries"</span><span>&gt;3 / 3&lt;/</span><span class="text-codex-syntax-name">strong</span><span>&gt;
                &lt;/</span><span class="text-codex-syntax-name">div</span><span>&gt;

                &lt;</span><span class="text-codex-syntax-name">div</span><span>&gt;
                    &lt;</span><span class="text-codex-syntax-name">span</span><span>&gt;STATUS&lt;/</span><span class="text-codex-syntax-name">span</span><span>&gt;
                    &lt;</span><span class="text-codex-syntax-name">strong</span><span>&gt;SUCCESSFUL&lt;/</span><span class="text-codex-syntax-name">strong</span><span>&gt;
                &lt;/</span><span class="text-codex-syntax-name">div</span><span>&gt;
            &lt;/</span><span class="text-codex-syntax-name">div</span><span>&gt;

            &lt;</span><span class="text-codex-syntax-name">button </span><span class="text-codex-syntax-attribute">id</span><span>=</span><span class="text-codex-syntax-string">"return-home" </span><span class="text-codex-syntax-attribute">class</span><span>=</span><span class="text-codex-syntax-string">"primary-button"</span><span>&gt;
                RETURN TO MISSION DATABASE →
            &lt;/</span><span class="text-codex-syntax-name">button</span><span>&gt;
        &lt;/</span><span class="text-codex-syntax-name">div</span><span>&gt;

    &lt;/</span><span class="text-codex-syntax-name">section</span><span>&gt;


    &lt;</span><span class="text-codex-syntax-name">script </span><span class="text-codex-syntax-attribute">src</span><span>=</span><span class="text-codex-syntax-string">"script.js"</span><span>&gt;&lt;/</span><span class="text-codex-syntax-name">script</span><span>&gt;
&lt;/</span><span class="text-codex-syntax-name">body</span><span>&gt;
&lt;/</span><span class="text-codex-syntax-name">html</span><span>&gt;</span></code></pre></div></div></div><button class="group/scroll-to-bottom cursor-interaction absolute z-30 flex h-8 translate-x-1/2 items-center justify-center rounded-full text-secondary transition-[width,opacity] duration-120 ease-out motion-reduce:transition-none end-1/2 print:hidden w-8 pointer-events-none opacity-0 bottom-4" aria-hidden="true" aria-label="Ir al final" tabindex="-1" type="button"><span class="pointer-events-none flex h-full shrink-0 items-center justify-center rounded-full border border-default bg-surface bg-clip-padding shadow-md transition-[width] duration-120 ease-out motion-reduce:transition-none w-8"><svg aria-hidden="true" class="Icon-X4VkKC text-default" focusable="false" height="20" viewBox="0 0 20 20" width="20" xmlns="http://www.w3.org/2000/svg"><use href="/cdn/assets/icons-65c0f11497ac4847.svg#codex-icon-arrow-down-lg-light-20" fill="currentColor"></use></svg></span></button></div></div></div></div><div class="Divider-aIXBUs" data-d-component="divider" style="--divider-color: var(--color-border); --divider-size: 1px;"></div><h2 class="TextBase-kDAqPL Title-ij922C" data-d-text-flow="" data-d-component="title" data-d-size="lg" data-d-weight="semibold"><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(237, 237, 237);"><strong class="Emphasis-BHzYtQ">2. </strong></span><code class="Code-LNMR8q" data-d-component="code"><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(237, 237, 237);">style.css</span></code></h2><p class="TextBase-kDAqPL Text-dOmvsS" data-d-text-flow="" data-d-component="text"><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(237, 237, 237);">Borrá el contenido anterior de </span><code class="Code-LNMR8q" data-d-component="code"><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(237, 237, 237);">style.css</span></code><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(237, 237, 237);"> y pegá esto:</span></p><div data-client-defined-widget="code_block"><div data-chatgpt-copy-code="@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&amp;family=Orbitron:wght@400;500;600;700;800&amp;display=swap');

:root {
    --background: #05080e;
    --panel: #101722;
    --blue: #55c8ff;
    --white: #f4f7fb;
    --muted: #8793a5;
    --border: rgba(255,255,255,0.12);
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    background: var(--background);
    color: var(--white);
    font-family: 'Inter', sans-serif;
    overflow-x: hidden;
}

button {
    font-family: inherit;
    cursor: pointer;
}

.screen {
    display: none;
    min-height: 100vh;
}

.screen.active {
    display: block;
}

#star-background {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
        radial-gradient(circle at 20% 30%, rgba(34,87,130,.16), transparent 35%),
        radial-gradient(circle at 80% 70%, rgba(29,58,94,.12), transparent 35%),
        #05080e;
}

#star-background::after {
    content: &quot;&quot;;
    position: absolute;
    inset: 0;
    opacity: .35;
    background-image:
        radial-gradient(1px 1px at 20px 30px, white, transparent),
        radial-gradient(1px 1px at 100px 80px, white, transparent),
        radial-gradient(2px 2px at 200px 150px, white, transparent),
        radial-gradient(1px 1px at 300px 40px, white, transparent),
        radial-gradient(1px 1px at 400px 180px, white, transparent);
    background-size: 450px 220px;
}

/* HEADER */

.topbar,
.subpage-header {
    height: 80px;
    padding: 0 7%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--border);
}

.logo,
.game-logo {
    font-family: 'Orbitron', sans-serif;
    font-size: 25px;
    font-weight: 800;
    letter-spacing: 3px;
}

.logo span,
.game-logo span {
    color: var(--blue);
}

.topbar-label {
    color: var(--muted);
    font-size: 10px;
    letter-spacing: 3px;
}

.eyebrow {
    color: var(--blue);
    font-family: 'Orbitron', sans-serif;
    font-size: 10px;
    letter-spacing: 2px;
}

/* HERO */

.hero {
    min-height: 570px;
    padding: 100px 10% 70px;
    display: flex;
    align-items: center;
    position: relative;
    background:
        linear-gradient(90deg, rgba(5,8,14,.98), rgba(5,8,14,.62), rgba(5,8,14,.15)),
        url(&quot;images/space-background.jpg&quot;) center/cover;
}

.hero-content {
    max-width: 680px;
}

.hero h1 {
    margin: 22px 0;
    font-family: 'Orbitron', sans-serif;
    font-size: clamp(48px, 7vw, 88px);
    line-height: 1.05;
    letter-spacing: -3px;
}

.hero h1 span {
    color: var(--blue);
}

.hero-description {
    max-width: 520px;
    color: #aab5c5;
    line-height: 1.8;
    font-size: 14px;
}

.primary-button {
    margin-top: 32px;
    padding: 16px 24px;
    border: 1px solid var(--blue);
    background: var(--blue);
    color: #06111b;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
    transition: .25s;
}

.primary-button:hover {
    background: transparent;
    color: var(--blue);
    transform: translateY(-3px);
}

.primary-button span {
    margin-left: 20px;
}

.hero-coordinate {
    position: absolute;
    bottom: 35px;
    right: 8%;
    color: #758194;
    font-size: 9px;
    line-height: 1.8;
    letter-spacing: 1px;
}

/* MISSIONS */

.missions-section {
    padding: 70px 8% 90px;
}

.section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    margin-bottom: 35px;
}

.section-heading h2 {
    margin-top: 12px;
    font-family: 'Orbitron', sans-serif;
    font-size: 26px;
}

.mission-counter {
    color: var(--muted);
    font-size: 10px;
    letter-spacing: 1px;
}

.mission-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
}

.mission-card {
    background: #0d141e;
    border: 1px solid var(--border);
    transition: .3s;
    overflow: hidden;
}

.mission-card:hover {
    transform: translateY(-8px);
    border-color: var(--blue);
    box-shadow: 0 15px 45px rgba(0,0,0,.35);
}

.mission-image {
    height: 190px;
    position: relative;
    overflow: hidden;
    background: #172331;
}

.mission-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: .5s;
}

.mission-card:hover .mission-image img {
    transform: scale(1.07);
}

.mission-number {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 7px 10px;
    background: rgba(0,0,0,.65);
    font-family: 'Orbitron', sans-serif;
    font-size: 10px;
}

.mission-info {
    padding: 22px 18px;
}

.location-tag {
    color: var(--blue);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 2px;
}

.mars-tag {
    color: #ff9b70;
}

.mission-info h3 {
    margin: 12px 0;
    font-family: 'Orbitron', sans-serif;
    font-size: 14px;
    line-height: 1.5;
}

.mission-info p {
    min-height: 60px;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.7;
}

.mission-button {
    margin-top: 15px;
    padding: 10px 0;
    border: 0;
    background: transparent;
    color: var(--blue);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
}

.main-footer {
    display: flex;
    justify-content: space-between;
    padding: 25px 8%;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 9px;
    letter-spacing: 1px;
}

/* BRIEFING */

.subpage-header {
    height: 75px;
}

.back-button {
    border: 0;
    background: transparent;
    color: var(--muted);
    font-size: 10px;
    letter-spacing: 1px;
}

.back-button:hover {
    color: var(--blue);
}

.briefing-container {
    width: 84%;
    max-width: 1200px;
    margin: 65px auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 55px;
    align-items: center;
}

.briefing-image {
    height: 530px;
    position: relative;
    background: #111b27;
}

.briefing-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(0,0,0,.65), transparent 60%);
}

#briefing-number {
    position: absolute;
    bottom: 25px;
    left: 25px;
    font-family: 'Orbitron', sans-serif;
    font-size: 12px;
    letter-spacing: 2px;
}

.briefing-content h1 {
    margin: 18px 0;
    font-family: 'Orbitron', sans-serif;
    font-size: 36px;
}

.briefing-content &gt; p:not(.eyebrow) {
    color: #aab5c5;
    line-height: 1.8;
    font-size: 13px;
}

.briefing-data {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin: 30px 0;
}

.briefing-data div,
.complete-stats div {
    padding: 14px;
    background: rgba(255,255,255,.04);
    border: 1px solid var(--border);
}

.briefing-data span,
.complete-stats span {
    display: block;
    margin-bottom: 9px;
    color: var(--muted);
    font-size: 9px;
    letter-spacing: 1px;
}

.briefing-data strong,
.complete-stats strong {
    font-size: 11px;
}

.objective-box {
    padding: 20px;
    border-left: 2px solid var(--blue);
    background: rgba(85,200,255,.06);
}

.objective-box h3 {
    margin: 10px 0;
    font-family: 'Orbitron', sans-serif;
    font-size: 13px;
}

.objective-box p:last-child {
    color: #aab5c5;
    font-size: 12px;
    line-height: 1.7;
}

/* TUTORIAL */

.tutorial-screen {
    padding: 50px 20px;
    align-items: center;
    justify-content: center;
}

.tutorial-screen.active {
    display: flex;
}

.tutorial-box {
    width: 100%;
    max-width: 760px;
    padding: 45px;
    background: #0e1722;
    border: 1px solid var(--border);
}

.tutorial-box h1 {
    margin: 15px 0;
    font-family: 'Orbitron', sans-serif;
    font-size: 28px;
}

.tutorial-intro {
    color: var(--muted);
    font-size: 13px;
}

.controls-grid {
    margin: 35px 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 25px;
}

.control-item {
    display: flex;
    gap: 18px;
    align-items: center;
}

.key-group {
    min-width: 90px;
    display: flex;
    gap: 4px;
}

kbd {
    padding: 8px;
    border: 1px solid #455365;
    background: #182535;
    color: white;
    font-size: 10px;
    font-family: 'Orbitron', sans-serif;
}

.control-item strong,
.control-item span {
    display: block;
}

.control-item strong {
    margin-bottom: 6px;
    font-size: 11px;
}

.control-item span {
    color: var(--muted);
    font-size: 11px;
    line-height: 1.5;
}

.tutorial-note {
    padding: 18px;
    background: rgba(85,200,255,.06);
    border-left: 2px solid var(--blue);
}

.tutorial-note strong {
    color: var(--blue);
    font-size: 10px;
    letter-spacing: 1px;
}

.tutorial-note p {
    margin-top: 8px;
    color: #b5c0ce;
    font-size: 12px;
    line-height: 1.6;
}

/* EXPLORATION */

.exploration-screen {
    height: 100vh;
    min-height: 600px;
    overflow: hidden;
    position: relative;
    background: #05080e;
}

#three-container {
    position: absolute;
    inset: 0;
}

#three-container canvas {
    display: block;
    width: 100%;
    height: 100%;
}

.game-header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 5;
    height: 75px;
    padding: 0 35px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: linear-gradient(180deg, rgba(0,0,0,.8), transparent);
}

.game-logo {
    font-size: 20px;
}

.game-mission span,
.game-mission strong {
    display: block;
}

.game-mission span {
    color: var(--blue);
    font-size: 9px;
    letter-spacing: 2px;
}

.game-mission strong {
    margin-top: 5px;
    font-family: 'Orbitron', sans-serif;
    font-size: 11px;
}

#exit-exploration {
    padding: 10px 15px;
    background: rgba(0,0,0,.4);
    border: 1px solid var(--border);
    color: white;
    font-size: 10px;
}

.game-hud {
    position: absolute;
    top: 100px;
    left: 30px;
    z-index: 4;
    display: flex;
    gap: 12px;
}

.hud-panel {
    min-width: 190px;
    padding: 17px;
    background: rgba(5,10,18,.82);
    border: 1px solid rgba(255,255,255,.15);
    backdrop-filter: blur(10px);
}

.hud-panel h3 {
    margin: 12px 0;
    font-family: 'Orbitron', sans-serif;
    font-size: 12px;
}

.hud-panel strong {
    display: block;
    margin-top: 12px;
    font-family: 'Orbitron', sans-serif;
    font-size: 11px;
}

.hud-panel p,
#environment-status {
    display: block;
    margin-top: 10px;
    color: var(--muted);
    font-size: 10px;
    line-height: 1.5;
}

.progress-track {
    height: 4px;
    background: #263344;
}

#progress-fill {
    width: 0%;
    height: 100%;
    background: var(--blue);
    transition: .3s;
}

.crosshair {
    position: absolute;
    top: 50%;
    left: 50%;
    color: white;
    font-size: 23px;
    transform: translate(-50%, -50%);
    text-shadow: 0 0 8px black;
    pointer-events: none;
}

#interaction-prompt {
    position: absolute;
    top: 57%;
    left: 50%;
    display: none;
    transform: translateX(-50%);
    padding: 12px 18px;
    background: rgba(0,0,0,.75);
    color: white;
    font-size: 10px;
    letter-spacing: 1px;
}

.discovery-message {
    display: none;
    position: absolute;
    z-index: 10;
    left: 50%;
    top: 50%;
    width: min(420px, 90%);
    padding: 28px;
    transform: translate(-50%, -50%);
    background: #0d1723;
    border: 1px solid var(--blue);
    box-shadow: 0 20px 70px rgba(0,0,0,.6);
}

.discovery-message.show {
    display: block;
}

.discovery-message h3 {
    margin: 12px 0;
    font-family: 'Orbitron', sans-serif;
    font-size: 18px;
}

.discovery-message p {
    color: #aab5c5;
    font-size: 12px;
    line-height: 1.7;
}

.discovery-message button {
    margin-top: 20px;
    padding: 12px;
    border: 1px solid var(--blue);
    background: transparent;
    color: var(--blue);
    font-size: 10px;
}

.minimap {
    position: absolute;
    right: 25px;
    bottom: 60px;
    width: 175px;
    padding: 12px;
    background: rgba(5,10,18,.8);
    border: 1px solid var(--border);
    text-align: center;
}

.minimap canvas {
    display: block;
    width: 150px;
    height: 150px;
    margin: 10px auto;
}

.minimap &gt; span:last-child {
    color: var(--muted);
    font-size: 8px;
    letter-spacing: 1px;
}

.game-controls {
    position: absolute;
    left: 30px;
    bottom: 25px;
    color: white;
    font-size: 9px;
    letter-spacing: 1px;
    text-shadow: 0 2px 5px black;
}

#pause-message {
    display: none;
    position: absolute;
    inset: 0;
    z-index: 20;
    align-items: center;
    justify-content: center;
    background: rgba(0,0,0,.65);
    text-align: center;
}

#pause-message.show {
    display: flex;
}

#pause-message h2 {
    font-family: 'Orbitron', sans-serif;
    font-size: 25px;
}

#pause-message p {
    margin-top: 12px;
    color: #b5c0ce;
    font-size: 12px;
}

/* COMPLETE */

.complete-screen {
    min-height: 100vh;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 30px;
    background:
        radial-gradient(circle at center, rgba(30,95,135,.18), transparent 55%);
}

.complete-screen.active {
    display: flex;
}

.complete-content {
    width: 100%;
    max-width: 700px;
}

.complete-symbol {
    width: 75px;
    height: 75px;
    margin: 30px auto;
    display: grid;
    place-items: center;
    border: 1px solid var(--blue);
    border-radius: 50%;
    color: var(--blue);
    font-size: 35px;
}

.complete-content h1 {
    font-family: 'Orbitron', sans-serif;
    font-size: clamp(40px, 7vw, 65px);
    line-height: 1.1;
}

.complete-content h1 span {
    color: var(--blue);
}

.complete-content &gt; p:not(.eyebrow) {
    margin-top: 20px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.7;
}

.complete-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin: 35px 0;
    text-align: left;
}

/* RESPONSIVE */

@media (max-width: 1000px) {
    .mission-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .briefing-container {
        grid-template-columns: 1fr;
    }

    .briefing-image {
        height: 350px;
    }
}

@media (max-width: 600px) {
    .topbar,
    .subpage-header {
        padding: 0 20px;
    }

    .topbar-label {
        display: none;
    }

    .hero {
        padding: 80px 25px;
    }

    .missions-section {
        padding: 50px 20px;
    }

    .mission-grid {
        grid-template-columns: 1fr;
    }

    .section-heading {
        align-items: start;
        flex-direction: column;
        gap: 15px;
    }

    .briefing-container {
        width: 90%;
        margin: 35px auto;
    }

    .briefing-content h1 {
        font-size: 25px;
    }

    .briefing-data {
        grid-template-columns: 1fr;
    }

    .tutorial-box {
        padding: 25px;
    }

    .controls-grid {
        grid-template-columns: 1fr;
    }

    .game-header {
        padding: 0 15px;
    }

    .game-hud {
        top: 85px;
        left: 10px;
        flex-direction: column;
    }

    .hud-panel {
        min-width: 150px;
        padding: 10px;
    }

    .location-panel {
        display: none;
    }

    .minimap {
        right: 10px;
        bottom: 55px;
        transform: scale(.75);
        transform-origin: bottom right;
    }

    .game-controls {
        left: 10px;
        font-size: 7px;
    }

    .complete-stats {
        grid-template-columns: 1fr;
    }

    .main-footer {
        flex-direction: column;
        gap: 12px;
    }
