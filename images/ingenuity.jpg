</span><span class="text-codex-syntax-keyword">function </span><span class="text-codex-syntax-variable">addBox</span><span>(</span><span class="text-codex-syntax-variable">parent</span><span>, </span><span class="text-codex-syntax-variable">x</span><span>, </span><span class="text-codex-syntax-variable">y</span><span>, </span><span class="text-codex-syntax-variable">z</span><span>, </span><span class="text-codex-syntax-variable">sx</span><span>, </span><span class="text-codex-syntax-variable">sy</span><span>, </span><span class="text-codex-syntax-variable">sz</span><span>, </span><span class="text-codex-syntax-variable">mat</span><span>) {

    </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">mesh </span><span class="text-codex-syntax-keyword">= new </span><span class="text-codex-syntax-literal">THREE</span><span>.</span><span class="text-codex-syntax-variable">Mesh</span><span>(
        </span><span class="text-codex-syntax-keyword">new </span><span class="text-codex-syntax-literal">THREE</span><span>.</span><span class="text-codex-syntax-variable">BoxGeometry</span><span>(</span><span class="text-codex-syntax-variable">sx</span><span>, </span><span class="text-codex-syntax-variable">sy</span><span>, </span><span class="text-codex-syntax-variable">sz</span><span>),
        </span><span class="text-codex-syntax-variable">mat</span><span>
</span><span class="text-codex-syntax-variable">    </span><span>);

    </span><span class="text-codex-syntax-variable">mesh</span><span>.</span><span class="text-codex-syntax-attribute">position</span><span>.</span><span class="text-codex-syntax-variable">set</span><span>(</span><span class="text-codex-syntax-variable">x</span><span>, </span><span class="text-codex-syntax-variable">y</span><span>, </span><span class="text-codex-syntax-variable">z</span><span>);
    </span><span class="text-codex-syntax-variable">parent</span><span>.</span><span class="text-codex-syntax-variable">add</span><span>(</span><span class="text-codex-syntax-variable">mesh</span><span>);

    </span><span class="text-codex-syntax-keyword">return </span><span class="text-codex-syntax-variable">mesh</span><span>;
}


</span><span class="text-codex-syntax-keyword">function </span><span class="text-codex-syntax-variable">addCylinder</span><span>(</span><span class="text-codex-syntax-variable">parent</span><span>, </span><span class="text-codex-syntax-variable">x</span><span>, </span><span class="text-codex-syntax-variable">y</span><span>, </span><span class="text-codex-syntax-variable">z</span><span>, </span><span class="text-codex-syntax-variable">radiusTop</span><span>, </span><span class="text-codex-syntax-variable">radiusBottom</span><span>, </span><span class="text-codex-syntax-variable">height</span><span>, </span><span class="text-codex-syntax-variable">mat</span><span>) {

    </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">mesh </span><span class="text-codex-syntax-keyword">= new </span><span class="text-codex-syntax-literal">THREE</span><span>.</span><span class="text-codex-syntax-variable">Mesh</span><span>(
        </span><span class="text-codex-syntax-keyword">new </span><span class="text-codex-syntax-literal">THREE</span><span>.</span><span class="text-codex-syntax-variable">CylinderGeometry</span><span>(
