    </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">dark </span><span class="text-codex-syntax-keyword">= </span><span class="text-codex-syntax-variable">material</span><span>(</span><span class="text-codex-syntax-literal">0x252b31</span><span>, </span><span class="text-codex-syntax-literal">0.7</span><span>, </span><span class="text-codex-syntax-literal">0.3</span><span>);
    </span><span class="text-codex-syntax-keyword">const </span><span class="text-codex-syntax-variable">glass </span><span class="text-codex-syntax-keyword">= new </span><span class="text-codex-syntax-literal">THREE</span><span>.</span><span class="text-codex-syntax-variable">MeshStandardMaterial</span><span>({
