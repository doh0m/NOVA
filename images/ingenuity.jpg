                &lt;</span><span class="text-codex-syntax-name">span </span><span class="text-codex-syntax-attribute">class</span><span>=</span><span class="text-codex-syntax-string">"eyebrow"</span><span>&gt;MISSION OBJECTIVES&lt;/</span><span class="text-codex-syntax-name">span</span><span>&gt;
                &lt;</span><span class="text-codex-syntax-name">h3 </span><span class="text-codex-syntax-attribute">id</span><span>=</span><span class="text-codex-syntax-string">"objective-progress"</span><span>&gt;0 / 3 DISCOVERIES&lt;/</span><span class="text-codex-syntax-name">h3</span><span>&gt;

                &lt;</span><span class="text-codex-syntax-name">div </span><span class="text-codex-syntax-attribute">class</span><span>=</span><span class="text-codex-syntax-string">"progress-track"</span><span>&gt;
                    &lt;</span><span class="text-codex-syntax-name">div </span><span class="text-codex-syntax-attribute">id</span><span>=</span><span class="text-codex-syntax-string">"progress-fill"</span><span>&gt;&lt;/</span><span class="text-codex-syntax-name">div</span><span>&gt;
                &lt;/</span><span class="text-codex-syntax-name">div</span><span>&gt;

