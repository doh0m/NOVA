    </span><span class="text-codex-syntax-attribute">background</span><span>:
        </span><span class="text-codex-syntax-variable">radial-gradient</span><span>(</span><span class="text-codex-syntax-literal">circle at 20% 30%</span><span>, </span><span class="text-codex-syntax-variable">rgba</span><span>(</span><span class="text-codex-syntax-literal">34</span><span>,</span><span class="text-codex-syntax-literal">87</span><span>,</span><span class="text-codex-syntax-literal">130</span><span>,</span><span class="text-codex-syntax-literal">.16</span><span>), </span><span class="text-codex-syntax-literal">transparent 35%</span><span>),
        </span><span class="text-codex-syntax-variable">radial-gradient</span><span>(</span><span class="text-codex-syntax-literal">circle at 80% 70%</span><span>, </span><span class="text-codex-syntax-variable">rgba</span><span>(</span><span class="text-codex-syntax-literal">29</span><span>,</span><span class="text-codex-syntax-literal">58</span><span>,</span><span class="text-codex-syntax-literal">94</span><span>,</span><span class="text-codex-syntax-literal">.12</span><span>), </span><span class="text-codex-syntax-literal">transparent 35%</span><span>),
        </span><span class="text-codex-syntax-string">#05080e</span><span>;
}

</span><span class="text-codex-syntax-attribute">#star-background::after </span><span>{
    </span><span class="text-codex-syntax-attribute">content</span><span>: </span><span class="text-codex-syntax-string">""</span><span>;
    </span><span class="text-codex-syntax-attribute">position</span><span>: </span><span class="text-codex-syntax-literal">absolute</span><span>;
    </span><span class="text-codex-syntax-attribute">inset</span><span>: </span><span class="text-codex-syntax-literal">0</span><span>;
    </span><span class="text-codex-syntax-attribute">opacity</span><span>: </span><span class="text-codex-syntax-literal">.35</span><span>;
    </span><span class="text-codex-syntax-attribute">background-image</span><span>:
        </span><span class="text-codex-syntax-variable">radial-gradient</span><span>(</span><span class="text-codex-syntax-literal">1px 1px at 20px 30px</span><span>, </span><span class="text-codex-syntax-literal">white</span><span>, </span><span class="text-codex-syntax-literal">transparent</span><span>),
        </span><span class="text-codex-syntax-variable">radial-gradient</span><span>(</span><span class="text-codex-syntax-literal">1px 1px at 100px 80px</span><span>, </span><span class="text-codex-syntax-literal">white</span><span>, </span><span class="text-codex-syntax-literal">transparent</span><span>),
        </span><span class="text-codex-syntax-variable">radial-gradient</span><span>(</span><span class="text-codex-syntax-literal">2px 2px at 200px 150px</span><span>, </span><span class="text-codex-syntax-literal">white</span><span>, </span><span class="text-codex-syntax-literal">transparent</span><span>),
        </span><span class="text-codex-syntax-variable">radial-gradient</span><span>(</span><span class="text-codex-syntax-literal">1px 1px at 300px 40px</span><span>, </span><span class="text-codex-syntax-literal">white</span><span>, </span><span class="text-codex-syntax-literal">transparent</span><span>),
        </span><span class="text-codex-syntax-variable">radial-gradient</span><span>(</span><span class="text-codex-syntax-literal">1px 1px at 400px 180px</span><span>, </span><span class="text-codex-syntax-literal">white</span><span>, </span><span class="text-codex-syntax-literal">transparent</span><span>);
    </span><span class="text-codex-syntax-attribute">background-size</span><span>: </span><span class="text-codex-syntax-literal">450px 220px</span><span>;
}

</span><span class="Comment-dh5VVn">/* HEADER */</span><span>

</span><span class="text-codex-syntax-attribute">.topbar</span><span>,
</span><span class="text-codex-syntax-attribute">.subpage-header </span><span>{
    </span><span class="text-codex-syntax-attribute">height</span><span>: </span><span class="text-codex-syntax-literal">80px</span><span>;
    </span><span class="text-codex-syntax-attribute">padding</span><span>: </span><span class="text-codex-syntax-literal">0 7%</span><span>;
    </span><span class="text-codex-syntax-attribute">display</span><span>: </span><span class="text-codex-syntax-literal">flex</span><span>;
    </span><span class="text-codex-syntax-attribute">align-items</span><span>: </span><span class="text-codex-syntax-literal">center</span><span>;
    </span><span class="text-codex-syntax-attribute">justify-content</span><span>: </span><span class="text-codex-syntax-literal">space-between</span><span>;
    </span><span class="text-codex-syntax-attribute">border-bottom</span><span>: </span><span class="text-codex-syntax-literal">1px solid </span><span class="text-codex-syntax-variable">var</span><span>(</span><span class="text-codex-syntax-variable">--border</span><span>);
}

</span><span class="text-codex-syntax-attribute">.logo</span><span>,
</span><span class="text-codex-syntax-attribute">.game-logo </span><span>{
    </span><span class="text-codex-syntax-attribute">font-family</span><span>: </span><span class="text-codex-syntax-string">'Orbitron'</span><span>, </span><span class="text-codex-syntax-literal">sans-serif</span><span>;
    </span><span class="text-codex-syntax-attribute">font-size</span><span>: </span><span class="text-codex-syntax-literal">25px</span><span>;
    </span><span class="text-codex-syntax-attribute">font-weight</span><span>: </span><span class="text-codex-syntax-literal">800</span><span>;
