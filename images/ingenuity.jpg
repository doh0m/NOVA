    </span><span class="text-codex-syntax-attribute">font-family</span><span>: </span><span class="text-codex-syntax-string">'Inter'</span><span>, </span><span class="text-codex-syntax-literal">sans-serif</span><span>;
    </span><span class="text-codex-syntax-attribute">overflow-x</span><span>: </span><span class="text-codex-syntax-literal">hidden</span><span>;
