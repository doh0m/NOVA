            &lt;/</span><span class="text-codex-syntax-name">div</span><span>&gt;

            &lt;</span><span class="text-codex-syntax-name">div </span><span class="text-codex-syntax-attribute">class</span><span>=</span><span class="text-codex-syntax-string">"hud-panel location-panel"</span><span>&gt;
                &lt;</span><span class="text-codex-syntax-name">span </span><span class="text-codex-syntax-attribute">class</span><span>=</span><span class="text-codex-syntax-string">"eyebrow"</span><span>&gt;CURRENT LOCATION&lt;/</span><span class="text-codex-syntax-name">span</span><span>&gt;
                &lt;</span><span class="text-codex-syntax-name">strong </span><span class="text-codex-syntax-attribute">id</span><span>=</span><span class="text-codex-syntax-string">"current-location"</span><span>&gt;LUNAR SURFACE&lt;/</span><span class="text-codex-syntax-name">strong</span><span>&gt;
                &lt;</span><span class="text-codex-syntax-name">span </span><span class="text-codex-syntax-attribute">id</span><span>=</span><span class="text-codex-syntax-string">"environment-status"</span><span>&gt;ENVIRONMENT STABLE&lt;/</span><span class="text-codex-syntax-name">span</span><span>&gt;
            &lt;/</span><span class="text-codex-syntax-name">div</span><span>&gt;

